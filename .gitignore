__pycache__/
*.pyc
*.swp
.~lock.*#
cancelled_check.jpeg
NMI_HYD_jun11.pdf
NMI_HYD_TICKET.pdf

# Reference/verification material (not ours to version -- includes large binaries).
# Anchored to the repo root: compiler/verification/ is R6.2A's own simulator
# regression harness and IS versioned.
/verification/

# Build/run artifacts — regenerated by the compiler + toolchain, not source.
# A cloner rebuilds these by running the compiler; they don't belong in the repo
# (and the -v run logs can be hundreds of MB).
*.mcode
*.obj
*.log
*.result
data.map
*.map
*.clog
*.aln
*.disass
*.aligned.mcode
*.disass.mcode

# ── Toolchain stderr captures ──────────────────────────────────────────────────
# align.err / as.err / al.err (152 files) are the stderr of mcode_align and
# mcode_assemble, rewritten on every run alongside the *.mcode/*.obj they
# accompany. They are diagnostics to READ after a build (mcode_align failures
# are silent otherwise), not source. Verified: no tracked file uses .err.
*.err

# ── apara-cc generated per-program scaffolding ─────────────────────────────────
# apara-cc emits run.sh + clean.sh into every program output directory (see the
# header of ./apara-cc). All 269 untracked copies are the same single-program
# template with only NAME= substituted, and clean.sh is byte-identical
# everywhere. Regenerated by recompiling; not hand-written.
# NOTE: 18 copies were committed before this rule existed. .gitignore does not
# affect already-tracked files, so those stay tracked and keep showing edits.
# If you ever hand-write a real driver at one of these names: git add -f <path>
run.sh
clean.sh

# ── Superseded compiler snapshots ──────────────────────────────────────────────
# compiler_backup_{preopt,3steps,4pass}/ are manual pre-git snapshots of the
# compiler from June. They are redundant now that the history covers that era:
# compiler_backup_3steps/compiler.py and compiler_backup_4pass/compiler.py were
# verified BYTE-IDENTICAL to tags opt-3steps-validated and opt-4pass-validated.
# Kept on disk, out of the index.
compiler_backup_*/

# ── LaTeX / document build artifacts ───────────────────────────────────────────
# The reports, the ISA/compiler manuals and the thesis are written in .tex and
# compiled locally. The .tex SOURCE stays tracked — only the regenerable build
# products are ignored. Verified: every untracked .out in the repo is LaTeX
# (9/9), and no tracked file uses any of these extensions.
*.aux
*.toc
*.out
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# ── Editor / temporary files ───────────────────────────────────────────────────
# Emacs autosaves (#presentation.tex# is currently sitting in thesis_final/),
# emacs lock files, and the usual editor and patch leftovers.
# The leading '#' MUST be escaped as \# — an unescaped '#' starts a comment.
\#*\#
.\#*
*~
*.bak
*.orig
*.rej
*.tmp

# ── Private / unpublished thesis material (NEVER publish) ─────────────────────
# Kept locally, deliberately excluded from the published repository. Added when
# the publish/apara-compiler branch was created; see R12 audit.
My_mtp_phase1_draft.pdf
Post_MTP_Progress_Update.pdf
Post_MTP_Progress_Update.docx
Post_MTP_Progress_Update.md
thesis_final/
thesis_report/
meeting_report/
# Third-party / unconfirmed authorship -- do not redistribute until confirmed
compiler_support_documents/
# Catch-all for future drafts dropped at the repository root
/*_draft*.pdf
/*MTP*.pdf
/*MTP*.docx
/*thesis*.pdf
/*Thesis*.pdf
