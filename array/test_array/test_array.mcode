// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
    + $r30 ($i64) $r0 10
;
||
    + $r26 ($i64) $r0 $r27
    $st ($i32) [$r28 + 0] $r30
;
||
    + $r30 ($i64) $r0 20
;
||
    $st ($i32) [$r28 + 8] $r30
;
||
    + $r30 ($i64) $r0 30
;
||
    $st ($i32) [$r28 + 16] $r30
;
||
    + $r30 ($i64) $r0 40
;
||
    $st ($i32) [$r28 + 24] $r30
;
||
    + $r30 ($i64) $r0 50
;
||
    $st ($i32) [$r28 + 32] $r30
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 824
    + $r2 ($i64) $r0 0
    + $r3 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -16
    + $r4 ($i64) $r26 -8
    + $r5 ($i64) $r26 -16
    + $r6 ($i64) $r26 -16
    + $r7 ($i64) $r26 -8
    + $r8 ($i64) $r26 -8
    + $r9 ($i64) $r26 -8
    + $r11 ($i64) $r26 -16
;
||
    $st ($i32) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
;
||
    $st ($i32) [$r2 + 0] $r3
    $ld ($i32) $r10 [$r9 + 0]
    $ld ($i32) $r12 [$r11 + 0]
;
||
    + $r3 ($i64) $r26 -8
;
fc_1:
||
    + $r13 ($i64) $r0 $r10
    + $r14 ($i64) $r0 5
;
||
    - $r15 ($i64) $r14 $r13
;
||
    ? ($i64) $r15 > $goto fb_2
;
||
    ? ($i64) $r0 == $goto fe_4
;
fb_2:
||
    + $r14 ($i64) $r0 $r10
;
||
    * $r15 ($i64) $r14 8
;
||
    + $r17 ($i64) $r15 0
    + $r19 ($i64) $r15 0
;
||
    + $r17 ($i64) $r28 $r17
    + $r19 ($i64) $r28 $r19
;
||
    $ld ($i32) $r16 [$r17 + 0]
;
||
    + $r17 ($i64) $r15 40
;
||
    + $r17 ($i64) $r28 $r17
;
||
    $st ($i64) [$r17 + 0] $r16
    $ld ($i32) $r18 [$r19 + 0]
;
||
    + $r17 ($i64) $r0 $r12
;
||
    + $r19 ($i64) $r17 $r18
;
||
    + $r12 ($i64) $r0 $r19
;
fi_3:
||
    + $r20 ($i64) $r0 $r10
;
||
    + $r21 ($i64) $r0 $r20
    + $r22 ($i64) $r20 1
;
||
    + $r10 ($i64) $r0 $r22
    ? ($i64) $r0 == $goto fc_1
;
fe_4:
||
    + $r23 ($i64) $r26 -8
    + $r24 ($i64) $r26 -16
    + $r25 ($i64) $r26 -16
    + $r30 ($i64) $r0 40
    + $r1 ($i64) $r0 1
;
||
    $st ($i32) [$r23 + 0] $r10
    $st ($i32) [$r24 + 0] $r12
    $ld ($i32) $r29 [$r25 + 0]
    + $r31 ($i64) $r30 40
;
||
    + $r31 ($i64) $r28 $r31
;
||
    $st ($i64) [$r31 + 0] $r29
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
