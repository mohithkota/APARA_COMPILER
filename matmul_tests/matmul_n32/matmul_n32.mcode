// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 824
    + $r2 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r3 ($i64) $r26 -16
    + $r4 ($i64) $r26 -16
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -16
    + $r7 ($i64) $r26 -16
    + $r8 ($i64) $r26 -8
    + $r9 ($i64) $r26 -8
;
||
    $st ($i32) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
;
wc_1:
||
    $ld ($i32) $r10 [$r2 + 0]
    + $r11 ($i64) $r0 32
;
||
    - $r12 ($i64) $r11 $r10
;
||
    ? ($i64) $r12 > $goto wb_2
;
||
    ? ($i64) $r0 == $goto we_3
;
wb_2:
||
    + $r11 ($i64) $r0 0
;
||
    $st ($i32) [$r3 + 0] $r11
    $ld ($i32) $r11 [$r5 + 0]
;
||
    * $r12 ($i64) $r11 32
;
wc_4:
||
    $ld ($i32) $r13 [$r4 + 0]
    + $r14 ($i64) $r0 32
;
||
    - $r15 ($i64) $r14 $r13
;
||
    ? ($i64) $r15 > $goto wb_5
;
||
    ? ($i64) $r0 == $goto we_6
;
wb_5:
||
    $ld ($i32) $r14 [$r6 + 0]
    + $r18 ($i64) $r0 256
    + $r22 ($i64) $r0 256
;
||
    + $r15 ($i64) $r12 $r14
;
||
    + $r16 ($i64) $r15 1
;
||
    / $r19 ($i64) $r16 $r18
;
||
    * $r19 ($i64) $r19 $r18
    + $r18 ($i64) $r15 0
;
||
    - $r17 ($i64) $r16 $r19
    + $r18 ($i64) $r28 $r18
;
||
    $st ($i8) [$r18 + 0] $r17
;
||
    * $r18 ($i64) $r14 32
;
||
    + $r19 ($i64) $r18 $r11
;
||
    + $r20 ($i64) $r19 1
;
||
    / $r23 ($i64) $r20 $r22
;
||
    * $r23 ($i64) $r23 $r22
    $set $r22 0 1024
;
||
    - $r21 ($i64) $r20 $r23
    + $r22 ($i64) $r22 $r15
    + $r23 ($i64) $r14 1
;
||
    + $r22 ($i64) $r28 $r22
;
||
    $st ($i8) [$r22 + 0] $r21
    $st ($i32) [$r7 + 0] $r23
;
||
    + $r22 ($i64) $r0 $r14
    ? ($i64) $r0 == $goto wc_4
;
we_6:
||
    $ld ($i32) $r24 [$r8 + 0]
;
||
    + $r25 ($i64) $r0 $r24
    + $r29 ($i64) $r24 1
;
||
    $st ($i32) [$r9 + 0] $r29
    ? ($i64) $r0 == $goto wc_1
;
we_3:
||
    + $r30 ($i64) $r26 -8
    + $r31 ($i64) $r0 0
    + $r1 ($i64) $r26 -16
    + $r10 ($i64) $r26 -16
    + $r13 ($i64) $r26 -8
    + $r16 ($i64) $r26 -16
    + $r17 ($i64) $r26 -16
    + $r18 ($i64) $r26 -8
;
||
    $st ($i32) [$r30 + 0] $r31
    + $r19 ($i64) $r26 -8
;
||
    + $r31 ($i64) $r26 -8
;
wc_7:
||
    $ld ($i32) $r20 [$r31 + 0]
    + $r15 ($i64) $r0 32
;
||
    - $r21 ($i64) $r15 $r20
;
||
    ? ($i64) $r21 > $goto wb_8
;
||
    ? ($i64) $r0 == $goto we_9
;
wb_8:
||
    + $r15 ($i64) $r0 0
    + $r23 ($i64) $r0 0
    + $r12 ($i64) $r0 0
;
||
    $st ($i32) [$r1 + 0] $r15
    $ld ($i32) $r15 [$r13 + 0]
;
||
    * $r21 ($i64) $r15 32
;
||
    + $r23 ($i64) $r23 $r21
;
||
    + $r14 ($i64) $r28 $r23
;
||
    $ld ($u128) $r2 [$r14 + 0]
;
||
    + $r23 ($i64) $r0 $r2
    + $r11 ($i64) $r0 $r3
    + $r2 ($i64) $r21 16
;
||
    + $r12 ($i64) $r12 $r2
;
||
    + $r3 ($i64) $r28 $r12
;
||
    $ld ($u128) $r4 [$r3 + 0]
;
||
    + $r12 ($i64) $r0 $r4
    + $r24 ($i64) $r0 $r5
;
wc_10:
||
    $ld ($i32) $r4 [$r10 + 0]
    + $r5 ($i64) $r0 32
;
||
    - $r29 ($i64) $r5 $r4
;
||
    ? ($i64) $r29 > $goto wb_11
;
||
    ? ($i64) $r0 == $goto we_12
;
wb_11:
||
    $ld ($i32) $r5 [$r16 + 0]
    $set $r7 0 1024
    $set $r30 0 1024
    $set $r4 0 2048
;
||
    * $r29 ($i64) $r5 32
    + $r15 ($i64) $r21 $r5
;
||
    + $r7 ($i64) $r7 $r29
    * $r14 ($i64) $r15 8
;
||
    + $r6 ($i64) $r28 $r7
    + $r4 ($i64) $r4 $r14
;
||
    $ld ($u128) $r2 [$r6 + 0]
    + $r4 ($i64) $r28 $r4
;
||
    + $r7 ($i64) $r0 $r2
    + $r8 ($i64) $r0 $r3
    + $r3 ($i64) $r29 16
;
||
    $dot $r2 ($vu8) $r23 $r7
    + $r30 ($i64) $r30 $r3
;
||
    $dot $accumulate $r2 ($vu8) $r11 $r8
    + $r9 ($i64) $r28 $r30
    + $r8 ($i64) $r5 1
;
||
    $ld ($u128) $r6 [$r9 + 0]
;
||
    + $r30 ($i64) $r0 $r6
    + $r20 ($i64) $r0 $r7
;
||
    $dot $r6 ($vu8) $r12 $r30
;
||
    $dot $accumulate $r6 ($vu8) $r24 $r20
;
||
    + $r7 ($i64) $r2 $r6
;
||
    $st ($i64) [$r4 + 0] $r7
    $st ($i32) [$r17 + 0] $r8
;
||
    + $r4 ($i64) $r0 $r5
    ? ($i64) $r0 == $goto wc_10
;
we_12:
||
    $ld ($i32) $r29 [$r18 + 0]
;
||
    + $r3 ($i64) $r0 $r29
    + $r9 ($i64) $r29 1
;
||
    $st ($i32) [$r19 + 0] $r9
    ? ($i64) $r0 == $goto wc_7
;
we_9:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
