// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 816
    + $r2 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r3 ($i64) $r26 -8
    + $r4 ($i64) $r26 -8
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -8
;
||
    $st ($i32) [$r1 + 0] $r2
    $ld ($i32) $r7 [$r6 + 0]
;
||
    + $r2 ($i64) $r26 -8
;
fc_1:
||
    + $r8 ($i64) $r0 $r7
    + $r9 ($i64) $r0 16
;
||
    - $r10 ($i64) $r9 $r8
;
||
    ? ($i64) $r10 > $goto fb_2
;
||
    ? ($i64) $r0 == $goto fe_4
;
fb_2:
||
    + $r9 ($i64) $r0 $r7
;
||
    + $r10 ($i64) $r9 1
    + $r11 ($i64) $r9 0
    + $r12 ($i64) $r9 16
;
||
    + $r11 ($i64) $r28 $r11
    + $r12 ($i64) $r28 $r12
;
||
    $st ($i8) [$r11 + 0] $r10
;
||
    + $r11 ($i64) $r0 1
;
||
    $st ($i8) [$r12 + 0] $r11
;
fi_3:
||
    + $r11 ($i64) $r0 $r7
;
||
    + $r12 ($i64) $r0 $r11
    + $r13 ($i64) $r11 1
;
||
    + $r7 ($i64) $r0 $r13
    ? ($i64) $r0 == $goto fc_1
;
fe_4:
||
    + $r14 ($i64) $r26 -8
    + $r15 ($i64) $r28 0
    + $r16 ($i64) $r28 16
    + $r1 ($i64) $r0 1
;
||
    $st ($i32) [$r14 + 0] $r7
    $ld ($u128) $r6 [$r15 + 0]
;
||
    + $r17 ($i64) $r0 $r6
    + $r18 ($i64) $r0 $r7
    $ld ($u128) $r6 [$r16 + 0]
;
||
    + $r19 ($i64) $r0 $r6
    + $r20 ($i64) $r0 $r7
    + $r7 ($i64) $r28 32
;
||
    $dot $r6 ($vu8) $r17 $r19
;
||
    $dot $accumulate $r6 ($vu8) $r18 $r20
;
||
    $st ($i64) [$r7 + 0] $r6
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
