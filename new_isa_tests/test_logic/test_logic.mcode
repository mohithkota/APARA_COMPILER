// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
    + $r30 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    $st ($i32) [$r28 + 0] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i32) [$r28 + 8] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i32) [$r28 + 16] $r30
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 824
    + $r2 ($i64) $r0 240
    + $r3 ($i64) $r0 15
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r5 ($i64) $r26 -16
;
||
    $st ($i32) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -16
;
||
    $st ($i32) [$r2 + 0] $r3
    $ld ($i32) $r6 [$r5 + 0]
;
||
    + $r3 ($i64) $r26 -8
;
||
    $ld ($i32) $r4 [$r3 + 0]
;
||
    ~| $r7 ($i64) $r4 $r6
    ~& $r8 ($i64) $r4 $r6
    ~^ $r9 ($i64) $r4 $r6
;
||
    $st ($i32) [$r28 + 0] $r7
    $st ($i32) [$r28 + 8] $r8
    $st ($i32) [$r28 + 16] $r9
;
||
    $ld ($i32) $r10 [$r28 + 0]
    $ld ($i32) $r11 [$r28 + 8]
    $ld ($i32) $r13 [$r28 + 16]
;
||
    + $r12 ($i64) $r10 $r11
;
||
    + $r14 ($i64) $r12 $r13
;
||
    + $r1 ($i64) $r0 $r14
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
