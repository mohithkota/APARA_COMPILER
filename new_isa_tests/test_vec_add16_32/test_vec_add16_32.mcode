// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 848
    $set $r2 0 4
    $set $r3 0 3
    $set $r4 0 2
    + $r5 ($i64) $r0 1
    + $r6 ($i64) $r0 5
    + $r7 ($i64) $r0 5
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    << $r7 ($i64) $r7 16
    $set $r11 0 12
    $set $r12 0 10
    $set $r13 0 8
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    $set $r5 0 6
    + $r10 ($i64) $r26 -40
    + $r14 ($i64) $r0 6
;
||
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    + $r6 ($i64) $r0 3
    << $r14 ($i64) $r14 16
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 7
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    | $r13 ($i64) $r13 $r14
;
||
    << $r3 ($i64) $r3 16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 0
    << $r13 ($i64) $r13 16
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 8
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    $set $r6 0 0
    | $r12 ($i64) $r12 $r13
;
||
    $st ($i64) [$r1 + 0] $r2
    | $r3 ($i64) $r3 $r4
    $set $r4 0 4
    << $r5 ($i64) $r5 16
    | $r6 ($i64) $r6 $r7
    + $r7 ($i64) $r26 -16
    << $r12 ($i64) $r12 16
;
||
    + $r2 ($i64) $r26 -16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 6
    << $r6 ($i64) $r6 16
    | $r11 ($i64) $r11 $r12
;
||
    $st ($i64) [$r2 + 0] $r3
    | $r5 ($i64) $r5 $r6
;
||
    + $r3 ($i64) $r26 -24
;
||
    $st ($i64) [$r3 + 0] $r4
;
||
    + $r4 ($i64) $r26 -32
;
||
    $st ($i64) [$r4 + 0] $r5
    $ld ($i64) $r8 [$r7 + 0]
;
||
    + $r5 ($i64) $r26 -8
;
||
    $ld ($i64) $r6 [$r5 + 0]
;
||
    $v + $r9 ($vu16) $r6 $r8
;
||
    $st ($i64) [$r10 + 0] $r9
    - $r12 ($i64) $r9 $r11
;
||
    ? ($i64) $r12 != $goto if_t_1
;
||
    ? ($i64) $r0 == $goto if_e_2
;
if_t_1:
||
    + $r11 ($i64) $r0 -1
;
||
    + $r1 ($i64) $r0 $r11
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_2:
||
    + $r12 ($i64) $r26 -24
    + $r14 ($i64) $r26 -32
    + $r17 ($i64) $r26 -40
    $set $r18 0 10
    $set $r19 0 0
    + $r20 ($i64) $r0 8
;
||
    $ld ($i64) $r13 [$r12 + 0]
    $ld ($i64) $r15 [$r14 + 0]
    << $r20 ($i64) $r20 16
;
||
    $v + $r16 ($vu32) $r13 $r15
    | $r19 ($i64) $r19 $r20
;
||
    $st ($i64) [$r17 + 0] $r16
    << $r19 ($i64) $r19 16
;
||
    | $r18 ($i64) $r18 $r19
;
||
    - $r19 ($i64) $r16 $r18
;
||
    ? ($i64) $r19 != $goto if_t_3
;
||
    ? ($i64) $r0 == $goto if_e_4
;
if_t_3:
||
    + $r18 ($i64) $r0 -2
;
||
    + $r1 ($i64) $r0 $r18
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_4:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
