// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 832
    $set $r2 0 0
    + $r3 ($i64) $r0 20
    $set $r7 0 0
    + $r8 ($i64) $r0 2
    + $r9 ($i64) $r0 1
    $set $r10 0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    $set $r1 0 0
    << $r3 ($i64) $r3 16
    << $r8 ($i64) $r8 16
    + $r11 ($i64) $r0 3
    $set $r12 0 0
    $set $r13 0 0
;
||
    | $r2 ($i64) $r2 $r3
    + $r3 ($i64) $r0 10
    + $r4 ($i64) $r26 -8
    | $r7 ($i64) $r7 $r8
    << $r11 ($i64) $r11 16
    + $r14 ($i64) $r0 4
    + $r17 ($i64) $r0 8
    + $r19 ($i64) $r0 1
;
||
    << $r2 ($i64) $r2 16
    | $r8 ($i64) $r9 $r7
    $set $r9 0 0
    | $r10 ($i64) $r10 $r11
    $set $r11 0 0
    << $r14 ($i64) $r14 16
    + $r18 ($i64) $r17 0
    $set $r17 0 512
;
||
    | $r1 ($i64) $r1 $r2
    << $r10 ($i64) $r10 16
    | $r13 ($i64) $r13 $r14
    + $r14 ($i64) $r26 -16
    + $r18 ($i64) $r28 $r18
    + $r20 ($i64) $r0 3
    $set $r21 0 0
    $set $r22 0 1024
;
||
    | $r2 ($i64) $r3 $r1
    + $r3 ($i64) $r26 -8
    | $r9 ($i64) $r9 $r10
    << $r13 ($i64) $r13 16
    << $r20 ($i64) $r20 16
    << $r22 ($i64) $r22 16
    $set $r23 0 0
    $set $r24 0 0
;
||
    $st ($i64) [$r3 + 0] $r2
    $ld ($i64) $r5 [$r4 + 0]
    | $r10 ($i64) $r8 $r9
    | $r12 ($i64) $r12 $r13
    + $r13 ($i64) $r26 -16
    | $r21 ($i64) $r21 $r22
    + $r25 ($i64) $r0 5
    $set $r29 0 0
;
||
    $vreduce + $r6 ($vi32) $r5
    << $r12 ($i64) $r12 16
    << $r25 ($i64) $r25 16
    $set $r30 0 1536
    $set $r31 0 0
    $set $r1 0 0
    + $r3 ($i64) $r0 7
    $set $r2 0 0
;
||
    $st ($i64) [$r28 + 0] $r6
    | $r11 ($i64) $r11 $r12
    | $r24 ($i64) $r24 $r25
    $set $r25 0 0
    << $r30 ($i64) $r30 16
    << $r3 ($i64) $r3 16
    $set $r4 0 2048
    + $r7 ($i64) $r0 16
;
||
    | $r12 ($i64) $r10 $r11
    << $r24 ($i64) $r24 16
    | $r29 ($i64) $r29 $r30
    $set $r30 0 0
    | $r1 ($i64) $r1 $r3
    $set $r3 0 0
    << $r4 ($i64) $r4 16
    + $r8 ($i64) $r7 0
;
||
    $st ($i64) [$r13 + 0] $r12
    $ld ($i64) $r15 [$r14 + 0]
    | $r23 ($i64) $r23 $r24
    << $r29 ($i64) $r29 16
    << $r1 ($i64) $r1 16
    | $r2 ($i64) $r2 $r4
    + $r4 ($i64) $r26 -24
    + $r8 ($i64) $r28 $r8
;
||
    $vreduce + $r16 ($vi16) $r15
    | $r25 ($i64) $r25 $r29
    | $r31 ($i64) $r31 $r1
    $set $r1 0 0
    << $r2 ($i64) $r2 16
;
||
    $st ($i64) [$r18 + 0] $r16
    << $r31 ($i64) $r31 16
    | $r3 ($i64) $r3 $r2
    + $r2 ($i64) $r26 -24
;
||
    | $r18 ($i64) $r19 $r17
    $set $r19 0 0
    | $r30 ($i64) $r30 $r31
    << $r3 ($i64) $r3 16
;
||
    | $r19 ($i64) $r19 $r20
    | $r1 ($i64) $r1 $r3
;
||
    | $r20 ($i64) $r18 $r19
;
||
    | $r22 ($i64) $r20 $r21
;
||
    | $r24 ($i64) $r22 $r23
;
||
    | $r29 ($i64) $r24 $r25
;
||
    | $r31 ($i64) $r29 $r30
;
||
    | $r3 ($i64) $r31 $r1
    + $r1 ($i64) $r0 1
;
||
    $st ($i64) [$r2 + 0] $r3
    $ld ($i64) $r5 [$r4 + 0]
;
||
    $vreduce + $r6 ($vi8) $r5
;
||
    $st ($i64) [$r8 + 0] $r6
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
