// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 848
    $set $r2 0 1800
    $set $r3 0 1286
    $set $r4 0 772
    + $r5 ($i64) $r0 258
    + $r6 ($i64) $r0 257
    + $r7 ($i64) $r0 1
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    << $r7 ($i64) $r7 16
    + $r8 ($i64) $r0 5
    + $r11 ($i64) $r0 36
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    $set $r5 0 257
    << $r8 ($i64) $r8 16
    + $r10 ($i64) $r26 -40
;
||
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    $set $r6 0 2
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 257
    << $r5 ($i64) $r5 16
    | $r6 ($i64) $r6 $r7
    $set $r7 0 6
;
||
    << $r3 ($i64) $r3 16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 3
    << $r6 ($i64) $r6 16
    | $r7 ($i64) $r7 $r8
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 257
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    $set $r6 0 7
    << $r7 ($i64) $r7 16
;
||
    $st ($i64) [$r1 + 0] $r2
    | $r3 ($i64) $r3 $r4
    $set $r4 0 4
    << $r5 ($i64) $r5 16
    | $r6 ($i64) $r6 $r7
    + $r7 ($i64) $r26 -16
;
||
    + $r2 ($i64) $r26 -16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 8
    << $r6 ($i64) $r6 16
;
||
    $st ($i64) [$r2 + 0] $r3
    | $r5 ($i64) $r5 $r6
;
||
    + $r3 ($i64) $r26 -24
;
||
    $st ($i64) [$r3 + 0] $r4
;
||
    + $r4 ($i64) $r26 -32
;
||
    $st ($i64) [$r4 + 0] $r5
    $ld ($i64) $r8 [$r7 + 0]
;
||
    + $r5 ($i64) $r26 -8
;
||
    $ld ($i64) $r6 [$r5 + 0]
;
||
    $dot $r9 ($vi8) $r6 $r8
;
||
    $st ($i64) [$r10 + 0] $r9
    - $r12 ($i64) $r9 $r11
;
||
    ? ($i64) $r12 != $goto if_t_1
;
||
    ? ($i64) $r0 == $goto if_e_2
;
if_t_1:
||
    + $r11 ($i64) $r0 -1
;
||
    + $r1 ($i64) $r0 $r11
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_2:
||
    + $r12 ($i64) $r26 -8
    + $r14 ($i64) $r26 -16
    + $r17 ($i64) $r0 100
    + $r18 ($i64) $r0 136
;
||
    $ld ($i64) $r13 [$r12 + 0]
    $ld ($i64) $r15 [$r14 + 0]
    + $r16 ($i64) $r0 $r17
    + $r17 ($i64) $r26 -40
;
||
    $dot $accumulate $r16 ($vi8) $r13 $r15
;
||
    $st ($i64) [$r17 + 0] $r16
    - $r19 ($i64) $r16 $r18
;
||
    ? ($i64) $r19 != $goto if_t_3
;
||
    ? ($i64) $r0 == $goto if_e_4
;
if_t_3:
||
    + $r18 ($i64) $r0 -2
;
||
    + $r1 ($i64) $r0 $r18
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_4:
||
    + $r19 ($i64) $r26 -24
    + $r21 ($i64) $r26 -32
    + $r24 ($i64) $r26 -40
    + $r25 ($i64) $r0 70
;
||
    $ld ($i64) $r20 [$r19 + 0]
    $ld ($i64) $r22 [$r21 + 0]
;
||
    $dot $r23 ($vi16) $r20 $r22
;
||
    $st ($i64) [$r24 + 0] $r23
    - $r29 ($i64) $r23 $r25
;
||
    ? ($i64) $r29 != $goto if_t_5
;
||
    ? ($i64) $r0 == $goto if_e_6
;
if_t_5:
||
    + $r25 ($i64) $r0 -3
;
||
    + $r1 ($i64) $r0 $r25
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_6:
||
    + $r29 ($i64) $r26 -24
    + $r31 ($i64) $r26 -32
    $set $r3 0 1000
    $set $r4 0 1070
;
||
    $ld ($i64) $r30 [$r29 + 0]
    $ld ($i64) $r1 [$r31 + 0]
    + $r2 ($i64) $r0 $r3
    + $r3 ($i64) $r26 -40
;
||
    $dot $accumulate $r2 ($vi16) $r30 $r1
;
||
    $st ($i64) [$r3 + 0] $r2
    - $r5 ($i64) $r2 $r4
;
||
    ? ($i64) $r5 != $goto if_t_7
;
||
    ? ($i64) $r0 == $goto if_e_8
;
if_t_7:
||
    + $r4 ($i64) $r0 -4
;
||
    + $r1 ($i64) $r0 $r4
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_8:
||
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -16
    + $r9 ($i64) $r26 -40
    + $r11 ($i64) $r0 36
;
||
    $ld ($i64) $r7 [$r5 + 0]
    $ld ($i64) $r8 [$r6 + 0]
;
||
    $dot $r10 ($vu8) $r7 $r8
;
||
    $st ($i64) [$r9 + 0] $r10
    - $r12 ($i64) $r10 $r11
;
||
    ? ($i64) $r12 != $goto if_t_9
;
||
    ? ($i64) $r0 == $goto if_e_10
;
if_t_9:
||
    + $r11 ($i64) $r0 -5
;
||
    + $r1 ($i64) $r0 $r11
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_10:
||
    + $r12 ($i64) $r26 -8
    + $r13 ($i64) $r26 -16
    + $r16 ($i64) $r0 100
    + $r18 ($i64) $r0 136
;
||
    $ld ($i64) $r14 [$r12 + 0]
    $ld ($i64) $r15 [$r13 + 0]
    + $r17 ($i64) $r0 $r16
    + $r16 ($i64) $r26 -40
;
||
    $dot $accumulate $r17 ($vu8) $r14 $r15
;
||
    $st ($i64) [$r16 + 0] $r17
    - $r19 ($i64) $r17 $r18
;
||
    ? ($i64) $r19 != $goto if_t_11
;
||
    ? ($i64) $r0 == $goto if_e_12
;
if_t_11:
||
    + $r18 ($i64) $r0 -6
;
||
    + $r1 ($i64) $r0 $r18
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_12:
||
    + $r19 ($i64) $r26 -24
    + $r20 ($i64) $r26 -32
    + $r23 ($i64) $r26 -40
    + $r25 ($i64) $r0 70
;
||
    $ld ($i64) $r21 [$r19 + 0]
    $ld ($i64) $r22 [$r20 + 0]
;
||
    $dot $r24 ($vu16) $r21 $r22
;
||
    $st ($i64) [$r23 + 0] $r24
    - $r29 ($i64) $r24 $r25
;
||
    ? ($i64) $r29 != $goto if_t_13
;
||
    ? ($i64) $r0 == $goto if_e_14
;
if_t_13:
||
    + $r25 ($i64) $r0 -7
;
||
    + $r1 ($i64) $r0 $r25
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_14:
||
    + $r29 ($i64) $r26 -24
    + $r30 ($i64) $r26 -32
    $set $r2 0 1000
    $set $r4 0 1070
;
||
    $ld ($i64) $r31 [$r29 + 0]
    $ld ($i64) $r1 [$r30 + 0]
    + $r3 ($i64) $r0 $r2
    + $r2 ($i64) $r26 -40
;
||
    $dot $accumulate $r3 ($vu16) $r31 $r1
;
||
    $st ($i64) [$r2 + 0] $r3
    - $r5 ($i64) $r3 $r4
;
||
    ? ($i64) $r5 != $goto if_t_15
;
||
    ? ($i64) $r0 == $goto if_e_16
;
if_t_15:
||
    + $r4 ($i64) $r0 -8
;
||
    + $r1 ($i64) $r0 $r4
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_16:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
