// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    $set $r2 0 52719
    $set $r3 0 30891
    $set $r4 0 13398
    + $r5 ($i64) $r0 18
    + $r18 ($i64) $r0 8
    + $r20 ($i64) $r0 16
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    + $r19 ($i64) $r18 0
    + $r21 ($i64) $r20 0
    + $r22 ($i64) $r0 24
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    + $r5 ($i64) $r26 -16
    + $r6 ($i64) $r26 -8
    + $r9 ($i64) $r26 -24
    + $r10 ($i64) $r26 -8
    + $r13 ($i64) $r26 -32
    + $r14 ($i64) $r26 -16
;
||
    << $r4 ($i64) $r4 16
    + $r16 ($i64) $r26 -24
    + $r19 ($i64) $r28 $r19
    + $r18 ($i64) $r26 -32
    + $r21 ($i64) $r28 $r21
    + $r23 ($i64) $r22 0
;
||
    | $r3 ($i64) $r3 $r4
    + $r23 ($i64) $r28 $r23
;
||
    << $r3 ($i64) $r3 16
;
||
    | $r2 ($i64) $r2 $r3
;
||
    $st ($i64) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
    + $r1 ($i64) $r0 1
;
||
    $ld ($i64) $r3 [$r2 + 0]
;
||
    $cast ($i64) $r4 ($i8) $r3
;
||
    $st ($i8) [$r5 + 0] $r4
    $ld ($i64) $r7 [$r6 + 0]
;
||
    $cast ($i64) $r8 ($i16) $r7
;
||
    $st ($i16) [$r9 + 0] $r8
    $ld ($i64) $r11 [$r10 + 0]
;
||
    $cast ($i64) $r12 ($i32) $r11
;
||
    $st ($i32) [$r13 + 0] $r12
    $ld ($i8) $r15 [$r14 + 0]
;
||
    $st ($i64) [$r28 + 0] $r15
    $ld ($i16) $r17 [$r16 + 0]
;
||
    $st ($i64) [$r19 + 0] $r17
    $ld ($i32) $r19 [$r18 + 0]
    + $r20 ($i64) $r15 $r17
;
||
    $st ($i64) [$r21 + 0] $r19
;
||
    + $r21 ($i64) $r20 $r19
;
||
    $st ($i64) [$r23 + 0] $r21
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
