// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 808
    $set $r2 0 4369
    $set $r3 0 4369
    $set $r4 0 4369
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    $set $r1 0 4369
    << $r4 ($i64) $r4 16
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 8738
;
||
    << $r3 ($i64) $r3 16
    << $r4 ($i64) $r4 16
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 8738
;
||
    << $r2 ($i64) $r2 16
    | $r3 ($i64) $r3 $r4
    $set $r4 0 13107
;
||
    | $r1 ($i64) $r1 $r2
    $set $r2 0 8738
    << $r3 ($i64) $r3 16
    << $r4 ($i64) $r4 16
;
||
    $st ($i64) [$r28 + 0] $r1
    | $r2 ($i64) $r2 $r3
;
||
    $set $r1 0 8738
    << $r2 ($i64) $r2 16
;
||
    | $r1 ($i64) $r1 $r2
    + $r2 ($i64) $r0 8
;
||
    + $r3 ($i64) $r2 0
    $set $r2 0 13107
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i64) [$r3 + 0] $r1
;
||
    $set $r1 0 13107
    $set $r3 0 13107
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 17476
;
||
    << $r3 ($i64) $r3 16
    << $r4 ($i64) $r4 16
;
||
    | $r2 ($i64) $r2 $r3
;
||
    << $r2 ($i64) $r2 16
;
||
    | $r1 ($i64) $r1 $r2
    + $r2 ($i64) $r0 16
;
||
    + $r3 ($i64) $r2 0
    $set $r2 0 17476
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i64) [$r3 + 0] $r1
;
||
    $set $r1 0 17476
    $set $r3 0 17476
;
||
    | $r3 ($i64) $r3 $r4
;
||
    << $r3 ($i64) $r3 16
;
||
    | $r2 ($i64) $r2 $r3
;
||
    << $r2 ($i64) $r2 16
;
||
    | $r1 ($i64) $r1 $r2
    + $r2 ($i64) $r0 24
;
||
    + $r3 ($i64) $r2 0
    + $r2 ($i64) $r28 0
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i64) [$r3 + 0] $r1
    $ld ($i64) $r3 [$r2 + 0]
    $ld ($i64) $r4 [$r2 + 8]
    $ld ($i64) $r5 [$r2 + 16]
    $ld ($i64) $r6 [$r2 + 24]
;
||
    + $r1 ($i64) $r28 32
    + $r8 ($i64) $r0 $r3
    + $r9 ($i64) $r0 $r4
    + $r10 ($i64) $r0 $r5
    + $r11 ($i64) $r0 $r6
;
||
    $st ($u256) [$r1 + 0] $r8
;
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
