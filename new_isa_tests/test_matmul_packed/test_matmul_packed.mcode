// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 856
    + $r2 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
;
||
    $st ($i32) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
;
||
    $ld ($i32) $r3 [$r2 + 0]
;
fc_1:
||
    + $r4 ($i64) $r0 $r3
    + $r5 ($i64) $r0 16
;
||
    - $r6 ($i64) $r5 $r4
;
||
    ? ($i64) $r6 > $goto fb_2
;
||
    ? ($i64) $r0 == $goto fe_4
;
fb_2:
||
    + $r5 ($i64) $r26 -16
    + $r6 ($i64) $r0 0
;
||
    $st ($i32) [$r5 + 0] $r6
;
||
    + $r6 ($i64) $r26 -16
;
||
    $ld ($i32) $r7 [$r6 + 0]
;
fc_5:
||
    + $r8 ($i64) $r0 $r7
    + $r9 ($i64) $r0 16
;
||
    - $r10 ($i64) $r9 $r8
;
||
    ? ($i64) $r10 > $goto fb_6
;
||
    ? ($i64) $r0 == $goto fe_8
;
fb_6:
||
    + $r9 ($i64) $r0 $r3
    + $r11 ($i64) $r0 $r7
    + $r15 ($i64) $r0 256
    + $r19 ($i64) $r0 256
;
||
    * $r10 ($i64) $r9 16
;
||
    + $r12 ($i64) $r10 $r11
;
||
    + $r13 ($i64) $r12 1
;
||
    / $r16 ($i64) $r13 $r15
;
||
    * $r16 ($i64) $r16 $r15
    + $r15 ($i64) $r12 0
;
||
    - $r14 ($i64) $r13 $r16
    + $r15 ($i64) $r28 $r15
;
||
    $st ($i8) [$r15 + 0] $r14
;
||
    * $r15 ($i64) $r11 16
;
||
    + $r16 ($i64) $r15 $r9
;
||
    + $r17 ($i64) $r16 1
;
||
    / $r20 ($i64) $r17 $r19
;
||
    * $r20 ($i64) $r20 $r19
    + $r19 ($i64) $r12 256
;
||
    - $r18 ($i64) $r17 $r20
    + $r19 ($i64) $r28 $r19
;
||
    $st ($i8) [$r19 + 0] $r18
;
fi_7:
||
    + $r19 ($i64) $r0 $r7
;
||
    + $r20 ($i64) $r0 $r19
    + $r21 ($i64) $r19 1
;
||
    + $r7 ($i64) $r0 $r21
    ? ($i64) $r0 == $goto fc_5
;
fe_8:
||
    + $r22 ($i64) $r26 -16
;
||
    $st ($i32) [$r22 + 0] $r7
;
fi_3:
||
    + $r23 ($i64) $r0 $r3
;
||
    + $r24 ($i64) $r0 $r23
    + $r25 ($i64) $r23 1
;
||
    + $r3 ($i64) $r0 $r25
    ? ($i64) $r0 == $goto fc_1
;
fe_4:
||
    + $r29 ($i64) $r26 -8
    + $r30 ($i64) $r26 -8
    + $r31 ($i64) $r0 0
    + $r2 ($i64) $r26 -32
;
||
    $st ($i32) [$r29 + 0] $r3
    $st ($i32) [$r30 + 0] $r31
    $ld ($i64) $r4 [$r2 + 0]
;
||
    + $r31 ($i64) $r26 -24
;
||
    $ld ($i64) $r1 [$r31 + 0]
;
fc_9:
||
    + $r5 ($i64) $r26 -8
    + $r8 ($i64) $r0 16
;
||
    $ld ($i32) $r6 [$r5 + 0]
;
||
    - $r10 ($i64) $r8 $r6
;
||
    ? ($i64) $r10 > $goto fb_10
;
||
    ? ($i64) $r0 == $goto fe_12
;
fb_10:
||
    $set $r10 0 2560
    + $r9 ($i64) $r0 0
    + $r16 ($i64) $r0 8
    $set $r17 0 2560
;
||
    + $r8 ($i64) $r28 $r10
    + $r10 ($i64) $r26 -8
    + $r17 ($i64) $r17 $r16
    + $r16 ($i64) $r26 -16
;
||
    $ld ($i32) $r13 [$r10 + 0]
    + $r17 ($i64) $r28 $r17
;
||
    * $r14 ($i64) $r13 16
;
||
    + $r9 ($i64) $r9 $r14
;
||
    + $r11 ($i64) $r28 $r9
;
||
    $ld ($u128) $r2 [$r11 + 0]
;
||
    + $r9 ($i64) $r0 $r2
    + $r15 ($i64) $r0 $r3
    $set $r3 0 2560
;
||
    $st ($i64) [$r8 + 0] $r9
    $st ($i64) [$r8 + 8] $r15
    $ld ($i64) $r2 [$r28 + $r3]
    $ld ($i64) $r3 [$r17 + 0]
;
||
    + $r1 ($i64) $r0 $r2
    + $r4 ($i64) $r0 $r3
    + $r17 ($i64) $r0 0
;
||
    $st ($i32) [$r16 + 0] $r17
;
fc_13:
||
    + $r17 ($i64) $r26 -16
    + $r18 ($i64) $r0 16
;
||
    $ld ($i32) $r12 [$r17 + 0]
;
||
    - $r19 ($i64) $r18 $r12
;
||
    ? ($i64) $r19 > $goto fb_14
;
||
    ? ($i64) $r0 == $goto fe_16
;
fb_14:
||
    $set $r19 0 2560
    + $r23 ($i64) $r0 256
    + $r30 ($i64) $r0 8
    $set $r31 0 2560
    + $r5 ($i64) $r0 $r4
    + $r10 ($i64) $r26 -8
    + $r11 ($i64) $r26 -16
    $set $r16 0 512
;
||
    + $r18 ($i64) $r28 $r19
    + $r19 ($i64) $r26 -16
    + $r31 ($i64) $r31 $r30
    + $r30 ($i64) $r26 -48
;
||
    $ld ($i32) $r21 [$r19 + 0]
    + $r31 ($i64) $r28 $r31
;
||
    * $r7 ($i64) $r21 16
;
||
    + $r23 ($i64) $r23 $r7
;
||
    + $r22 ($i64) $r28 $r23
;
||
    $ld ($u128) $r2 [$r22 + 0]
;
||
    + $r23 ($i64) $r0 $r2
    + $r25 ($i64) $r0 $r3
    $set $r3 0 2560
;
||
    $st ($i64) [$r18 + 0] $r23
    $st ($i64) [$r18 + 8] $r25
    $ld ($i64) $r2 [$r28 + $r3]
;
||
    + $r3 ($i64) $r26 -40
;
||
    $st ($i64) [$r3 + 0] $r2
    $ld ($i64) $r29 [$r31 + 0]
;
||
    $st ($i64) [$r30 + 0] $r29
    + $r31 ($i64) $r0 $r1
    $ld ($i32) $r13 [$r10 + 0]
    $ld ($i32) $r9 [$r11 + 0]
;
||
    $dot $r6 ($vu8) $r31 $r2
    * $r14 ($i64) $r13 16
;
||
    $dot $accumulate $r6 ($vu8) $r5 $r29
    + $r8 ($i64) $r14 $r9
;
||
    * $r15 ($i64) $r8 8
;
||
    + $r16 ($i64) $r16 $r15
;
||
    + $r16 ($i64) $r28 $r16
;
||
    $st ($i64) [$r16 + 0] $r6
;
fi_15:
||
    + $r16 ($i64) $r26 -16
    + $r21 ($i64) $r26 -16
;
||
    $ld ($i32) $r17 [$r16 + 0]
;
||
    + $r12 ($i64) $r0 $r17
    + $r19 ($i64) $r17 1
;
||
    $st ($i32) [$r21 + 0] $r19
    ? ($i64) $r0 == $goto fc_13
;
fe_16:
||
    + $r7 ($i64) $r26 -8
    + $r25 ($i64) $r26 -8
;
||
    $ld ($i32) $r22 [$r7 + 0]
;
||
    + $r23 ($i64) $r0 $r22
    + $r18 ($i64) $r22 1
;
||
    $st ($i32) [$r25 + 0] $r18
    ? ($i64) $r0 == $goto fc_9
;
fe_12:
||
    + $r3 ($i64) $r26 -24
    + $r30 ($i64) $r26 -32
;
||
    $st ($i64) [$r3 + 0] $r1
    $st ($i64) [$r30 + 0] $r4
;
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
