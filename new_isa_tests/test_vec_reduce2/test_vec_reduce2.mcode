// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    $set $r2 0 1800
    $set $r3 0 1286
    $set $r4 0 772
    + $r5 ($i64) $r0 258
    + $r6 ($i64) $r0 1
    + $r8 ($i64) $r0 36
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    $set $r5 0 2
    + $r7 ($i64) $r26 -32
;
||
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    + $r6 ($i64) $r0 3
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 3
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
;
||
    << $r3 ($i64) $r3 16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 0
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 4
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
;
||
    $st ($i64) [$r1 + 0] $r2
    | $r3 ($i64) $r3 $r4
    $set $r4 0 4
    << $r5 ($i64) $r5 16
;
||
    + $r2 ($i64) $r26 -16
    | $r4 ($i64) $r4 $r5
;
||
    $st ($i64) [$r2 + 0] $r3
;
||
    + $r3 ($i64) $r26 -24
;
||
    $st ($i64) [$r3 + 0] $r4
;
||
    + $r4 ($i64) $r26 -8
;
||
    $ld ($i64) $r5 [$r4 + 0]
;
||
    $vreduce + $r6 ($vi8) $r5
;
||
    $st ($i64) [$r7 + 0] $r6
    - $r9 ($i64) $r6 $r8
;
||
    ? ($i64) $r9 != $goto if_t_1
;
||
    ? ($i64) $r0 == $goto if_e_2
;
if_t_1:
||
    + $r8 ($i64) $r0 -1
;
||
    + $r1 ($i64) $r0 $r8
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_2:
||
    + $r9 ($i64) $r26 -16
    + $r12 ($i64) $r26 -32
    + $r13 ($i64) $r0 10
;
||
    $ld ($i64) $r10 [$r9 + 0]
;
||
    $vreduce + $r11 ($vi16) $r10
;
||
    $st ($i64) [$r12 + 0] $r11
    - $r14 ($i64) $r11 $r13
;
||
    ? ($i64) $r14 != $goto if_t_3
;
||
    ? ($i64) $r0 == $goto if_e_4
;
if_t_3:
||
    + $r13 ($i64) $r0 -2
;
||
    + $r1 ($i64) $r0 $r13
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_4:
||
    + $r14 ($i64) $r26 -24
    + $r17 ($i64) $r26 -32
    + $r18 ($i64) $r0 7
;
||
    $ld ($i64) $r15 [$r14 + 0]
;
||
    $vreduce + $r16 ($vi32) $r15
;
||
    $st ($i64) [$r17 + 0] $r16
    - $r19 ($i64) $r16 $r18
;
||
    ? ($i64) $r19 != $goto if_t_5
;
||
    ? ($i64) $r0 == $goto if_e_6
;
if_t_5:
||
    + $r18 ($i64) $r0 -3
;
||
    + $r1 ($i64) $r0 $r18
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_6:
||
    + $r19 ($i64) $r26 -8
    + $r22 ($i64) $r26 -32
    + $r23 ($i64) $r0 36
;
||
    $ld ($i64) $r20 [$r19 + 0]
;
||
    $vreduce + $r21 ($vu8) $r20
;
||
    $st ($i64) [$r22 + 0] $r21
    - $r24 ($i64) $r21 $r23
;
||
    ? ($i64) $r24 != $goto if_t_7
;
||
    ? ($i64) $r0 == $goto if_e_8
;
if_t_7:
||
    + $r23 ($i64) $r0 -4
;
||
    + $r1 ($i64) $r0 $r23
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_8:
||
    + $r24 ($i64) $r26 -16
    + $r30 ($i64) $r26 -32
    + $r31 ($i64) $r0 10
;
||
    $ld ($i64) $r25 [$r24 + 0]
;
||
    $vreduce + $r29 ($vu16) $r25
;
||
    $st ($i64) [$r30 + 0] $r29
    - $r1 ($i64) $r29 $r31
;
||
    ? ($i64) $r1 != $goto if_t_9
;
||
    ? ($i64) $r0 == $goto if_e_10
;
if_t_9:
||
    + $r31 ($i64) $r0 -5
;
||
    + $r1 ($i64) $r0 $r31
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_10:
||
    + $r1 ($i64) $r26 -24
    + $r4 ($i64) $r26 -32
    + $r5 ($i64) $r0 7
;
||
    $ld ($i64) $r2 [$r1 + 0]
;
||
    $vreduce + $r3 ($vu32) $r2
;
||
    $st ($i64) [$r4 + 0] $r3
    - $r7 ($i64) $r3 $r5
;
||
    ? ($i64) $r7 != $goto if_t_11
;
||
    ? ($i64) $r0 == $goto if_e_12
;
if_t_11:
||
    + $r5 ($i64) $r0 -6
;
||
    + $r1 ($i64) $r0 $r5
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_12:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
