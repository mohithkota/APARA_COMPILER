// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 824
    + $r2 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r3 ($i64) $r26 -16
    + $r4 ($i64) $r26 -16
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -16
    + $r7 ($i64) $r26 -16
    + $r8 ($i64) $r26 -8
    + $r9 ($i64) $r26 -8
;
||
    $st ($i32) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
;
wc_1:
||
    $ld ($i32) $r10 [$r2 + 0]
    + $r11 ($i64) $r0 16
;
||
    - $r12 ($i64) $r11 $r10
;
||
    ? ($i64) $r12 > $goto wb_2
;
||
    ? ($i64) $r0 == $goto we_3
;
wb_2:
||
    + $r11 ($i64) $r0 0
;
||
    $st ($i32) [$r3 + 0] $r11
    $ld ($i32) $r11 [$r5 + 0]
;
||
    * $r12 ($i64) $r11 16
;
wc_4:
||
    $ld ($i32) $r13 [$r4 + 0]
    + $r14 ($i64) $r0 16
;
||
    - $r15 ($i64) $r14 $r13
;
||
    ? ($i64) $r15 > $goto wb_5
;
||
    ? ($i64) $r0 == $goto we_6
;
wb_5:
||
    $ld ($i32) $r14 [$r6 + 0]
    + $r18 ($i64) $r0 256
    + $r22 ($i64) $r0 256
;
||
    + $r15 ($i64) $r12 $r14
;
||
    + $r16 ($i64) $r15 1
;
||
    / $r19 ($i64) $r16 $r18
;
||
    * $r19 ($i64) $r19 $r18
    + $r18 ($i64) $r15 0
;
||
    - $r17 ($i64) $r16 $r19
    + $r18 ($i64) $r28 $r18
;
||
    $st ($i8) [$r18 + 0] $r17
;
||
    * $r18 ($i64) $r14 16
;
||
    + $r19 ($i64) $r18 $r11
;
||
    + $r20 ($i64) $r19 1
;
||
    / $r23 ($i64) $r20 $r22
;
||
    * $r23 ($i64) $r23 $r22
    + $r22 ($i64) $r15 256
;
||
    - $r21 ($i64) $r20 $r23
    + $r22 ($i64) $r28 $r22
    + $r23 ($i64) $r14 1
;
||
    $st ($i8) [$r22 + 0] $r21
    $st ($i32) [$r7 + 0] $r23
;
||
    + $r22 ($i64) $r0 $r14
    ? ($i64) $r0 == $goto wc_4
;
we_6:
||
    $ld ($i32) $r24 [$r8 + 0]
;
||
    + $r25 ($i64) $r0 $r24
    + $r29 ($i64) $r24 1
;
||
    $st ($i32) [$r9 + 0] $r29
    ? ($i64) $r0 == $goto wc_1
;
we_3:
||
    + $r30 ($i64) $r26 -8
    + $r31 ($i64) $r0 0
    + $r1 ($i64) $r26 -16
    + $r10 ($i64) $r26 -16
    + $r13 ($i64) $r26 -8
    + $r16 ($i64) $r26 -16
    + $r17 ($i64) $r26 -16
    + $r18 ($i64) $r26 -8
;
||
    $st ($i32) [$r30 + 0] $r31
    + $r19 ($i64) $r26 -8
;
||
    + $r31 ($i64) $r26 -8
;
wc_7:
||
    $ld ($i32) $r20 [$r31 + 0]
    + $r15 ($i64) $r0 16
;
||
    - $r21 ($i64) $r15 $r20
;
||
    ? ($i64) $r21 > $goto wb_8
;
||
    ? ($i64) $r0 == $goto we_9
;
wb_8:
||
    + $r15 ($i64) $r0 0
    + $r23 ($i64) $r0 0
;
||
    $st ($i32) [$r1 + 0] $r15
    $ld ($i32) $r15 [$r13 + 0]
;
||
    * $r21 ($i64) $r15 16
;
||
    + $r23 ($i64) $r23 $r21
;
||
    + $r14 ($i64) $r28 $r23
;
||
    $ld ($u128) $r2 [$r14 + 0]
;
||
    + $r23 ($i64) $r0 $r2
    + $r11 ($i64) $r0 $r3
;
wc_10:
||
    $ld ($i32) $r2 [$r10 + 0]
    + $r3 ($i64) $r0 16
;
||
    - $r12 ($i64) $r3 $r2
;
||
    ? ($i64) $r12 > $goto wb_11
;
||
    ? ($i64) $r0 == $goto we_12
;
wb_11:
||
    $ld ($i32) $r3 [$r16 + 0]
    + $r29 ($i64) $r0 256
    $set $r8 0 512
;
||
    * $r12 ($i64) $r3 16
    + $r9 ($i64) $r3 1
;
||
    + $r29 ($i64) $r29 $r12
;
||
    + $r24 ($i64) $r28 $r29
;
||
    $ld ($u128) $r4 [$r24 + 0]
;
||
    + $r29 ($i64) $r0 $r4
    + $r6 ($i64) $r0 $r5
    + $r5 ($i64) $r21 $r3
;
||
    $dot $r4 ($vu8) $r23 $r29
    * $r7 ($i64) $r5 8
;
||
    $dot $accumulate $r4 ($vu8) $r11 $r6
    + $r8 ($i64) $r8 $r7
;
||
    + $r8 ($i64) $r28 $r8
;
||
    $st ($i64) [$r8 + 0] $r4
    $st ($i32) [$r17 + 0] $r9
;
||
    + $r8 ($i64) $r0 $r3
    ? ($i64) $r0 == $goto wc_10
;
we_12:
||
    $ld ($i32) $r30 [$r18 + 0]
;
||
    + $r20 ($i64) $r0 $r30
    + $r15 ($i64) $r30 1
;
||
    $st ($i32) [$r19 + 0] $r15
    ? ($i64) $r0 == $goto wc_7
;
we_9:
||
    $set $r2 0 512
;
||
    $ld ($i64) $r14 [$r28 + $r2]
;
||
    $set $r2 0 21896
;
||
    - $r12 ($i64) $r14 $r2
;
||
    ? ($i64) $r12 != $goto if_t_13
;
||
    ? ($i64) $r0 == $goto if_e_14
;
if_t_13:
||
    + $r2 ($i64) $r0 -1
;
||
    + $r1 ($i64) $r0 $r2
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_14:
||
    + $r24 ($i64) $r0 120
    $set $r29 0 512
;
||
    + $r29 ($i64) $r29 $r24
    $set $r24 0 19840
;
||
    + $r29 ($i64) $r28 $r29
;
||
    $ld ($i64) $r12 [$r29 + 0]
;
||
    - $r29 ($i64) $r12 $r24
;
||
    ? ($i64) $r29 != $goto if_t_15
;
||
    ? ($i64) $r0 == $goto if_e_16
;
if_t_15:
||
    + $r24 ($i64) $r0 -2
;
||
    + $r1 ($i64) $r0 $r24
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_16:
||
    $set $r6 0 2040
    $set $r5 0 512
;
||
    + $r5 ($i64) $r5 $r6
    $set $r6 0 21888
;
||
    + $r5 ($i64) $r28 $r5
;
||
    $ld ($i64) $r29 [$r5 + 0]
;
||
    + $r5 ($i64) $r0 7
;
||
    << $r5 ($i64) $r5 16
;
||
    | $r6 ($i64) $r6 $r5
;
||
    - $r5 ($i64) $r29 $r6
;
||
    ? ($i64) $r5 != $goto if_t_17
;
||
    ? ($i64) $r0 == $goto if_e_18
;
if_t_17:
||
    + $r6 ($i64) $r0 -3
;
||
    + $r1 ($i64) $r0 $r6
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_18:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
