// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    + $r2 ($i64) $r0 8
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r1 ($i64) $r0 1
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 16
;
||
    $st ($i32) [$r28 + 72] $r1
    + $r3 ($i64) $r28 $r3
    + $r4 ($i64) $r26 -16
    + $r5 ($i64) $r26 -32
    + $r6 ($i64) $r26 -24
    + $r7 ($i64) $r26 -24
    + $r8 ($i64) $r26 -32
    + $r9 ($i64) $r26 -8
;
||
    + $r1 ($i64) $r0 2
    + $r10 ($i64) $r26 -24
    + $r11 ($i64) $r26 -16
    + $r12 ($i64) $r26 -32
    + $r13 ($i64) $r26 -24
    + $r14 ($i64) $r26 -24
    + $r15 ($i64) $r26 -32
    + $r16 ($i64) $r26 -8
;
||
    $st ($i32) [$r3 + 0] $r1
    + $r17 ($i64) $r26 -16
    + $r18 ($i64) $r26 -16
    + $r19 ($i64) $r26 -16
    + $r20 ($i64) $r26 -8
    + $r21 ($i64) $r26 -8
;
||
    + $r1 ($i64) $r0 3
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 24
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 4
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 32
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 5
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 40
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 6
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 48
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 7
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 56
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 8
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 64
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 9
    + $r3 ($i64) $r2 72
    + $r2 ($i64) $r0 8
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 9
    + $r3 ($i64) $r2 144
    + $r2 ($i64) $r0 16
;
||
    $st ($i32) [$r28 + 144] $r1
    + $r3 ($i64) $r28 $r3
;
||
    + $r1 ($i64) $r0 8
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 7
    + $r3 ($i64) $r2 144
    + $r2 ($i64) $r0 24
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 6
    + $r3 ($i64) $r2 144
    + $r2 ($i64) $r0 32
;
||
    + $r3 ($i64) $r28 $r3
