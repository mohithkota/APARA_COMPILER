||
    + $r1 ($i64) $r0 3
    + $r3 ($i64) $r2 144
    + $r2 ($i64) $r0 56
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 2
    + $r3 ($i64) $r2 144
    + $r2 ($i64) $r0 64
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r0 1
    + $r3 ($i64) $r2 144
    + $r2 ($i64) $r0 0
