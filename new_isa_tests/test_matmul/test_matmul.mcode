;
||
    + $r30 ($i64) $r0 $r22
    + $r31 ($i64) $r22 1
;
||
    $st ($i32) [$r21 + 0] $r31
    ? ($i64) $r0 == $goto fc_1
;
fe_4:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
