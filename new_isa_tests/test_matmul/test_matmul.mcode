fc_9:
||
    $ld ($i32) $r1 [$r7 + 0]
    + $r22 ($i64) $r0 3
;
||
    - $r23 ($i64) $r22 $r1
;
||
    ? ($i64) $r23 > $goto fb_10
;
||
    ? ($i64) $r0 == $goto fe_12
;
fb_10:
||
    $ld ($i32) $r22 [$r8 + 0]
    $ld ($i32) $r23 [$r10 + 0]
;
||
    + $r25 ($i64) $r24 $r23
;
||
    * $r30 ($i64) $r25 8
;
||
    + $r25 ($i64) $r30 72
;
||
    + $r25 ($i64) $r28 $r25
;
||
    $ld ($i32) $r1 [$r25 + 0]
;
||
    * $r25 ($i64) $r23 3
;
||
    + $r30 ($i64) $r25 $r31
;
||
    * $r23 ($i64) $r30 8
;
||
    + $r30 ($i64) $r23 144
;
||
    + $r30 ($i64) $r28 $r30
;
||
    $ld ($i32) $r25 [$r30 + 0]
;
||
    * $r30 ($i64) $r1 $r25
;
||
    + $r23 ($i64) $r22 $r30
;
||
    $st ($i32) [$r12 + 0] $r23
;
fi_11:
||
    $ld ($i32) $r1 [$r13 + 0]
;
||
    + $r25 ($i64) $r0 $r1
    + $r22 ($i64) $r1 1
;
||
    $st ($i32) [$r14 + 0] $r22
    ? ($i64) $r0 == $goto fc_9
