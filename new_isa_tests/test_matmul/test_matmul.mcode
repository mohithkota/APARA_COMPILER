;
||
    $st ($i32) [$r3 + 0] $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r3 ($i64) $r26 -16
;
||
    $st ($i32) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
;
fc_1:
||
    $ld ($i32) $r22 [$r2 + 0]
    + $r23 ($i64) $r0 3
;
||
    - $r24 ($i64) $r23 $r22
;
||
    ? ($i64) $r24 > $goto fb_2
;
||
    ? ($i64) $r0 == $goto fe_4
