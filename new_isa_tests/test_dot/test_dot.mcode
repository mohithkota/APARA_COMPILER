// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    + $r2 ($i64) $r0 2
    + $r3 ($i64) $r0 1
    $set $r4 0 0
    + $r5 ($i64) $r0 3
    $set $r6 0 0
    $set $r7 0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    $set $r1 0 0
    << $r2 ($i64) $r2 16
    << $r5 ($i64) $r5 16
    + $r8 ($i64) $r0 4
    + $r25 ($i64) $r0 8
;
||
    | $r1 ($i64) $r1 $r2
    | $r4 ($i64) $r4 $r5
    $set $r5 0 0
    << $r8 ($i64) $r8 16
    + $r9 ($i64) $r26 -8
    + $r11 ($i64) $r26 -16
    + $r14 ($i64) $r26 -24
    + $r15 ($i64) $r26 -24
;
||
    | $r2 ($i64) $r3 $r1
    $set $r3 0 0
    << $r4 ($i64) $r4 16
    | $r7 ($i64) $r7 $r8
    + $r8 ($i64) $r26 -16
    + $r17 ($i64) $r26 -8
    + $r19 ($i64) $r26 -16
    + $r22 ($i64) $r26 -32
;
||
    | $r3 ($i64) $r3 $r4
    << $r7 ($i64) $r7 16
    + $r23 ($i64) $r26 -32
    + $r29 ($i64) $r25 0
    + $r1 ($i64) $r0 1
;
||
    | $r4 ($i64) $r2 $r3
    | $r6 ($i64) $r6 $r7
    + $r7 ($i64) $r26 -8
    + $r29 ($i64) $r28 $r29
;
||
    << $r6 ($i64) $r6 16
;
||
    | $r5 ($i64) $r5 $r6
;
||
    | $r6 ($i64) $r4 $r5
;
||
    $st ($i64) [$r7 + 0] $r6
    $st ($i64) [$r8 + 0] $r6
    $ld ($i64) $r10 [$r9 + 0]
    $ld ($i64) $r12 [$r11 + 0]
;
||
    $dot $r13 ($vi16) $r10 $r12
;
||
    $st ($i64) [$r14 + 0] $r13
    $ld ($i64) $r16 [$r15 + 0]
;
||
    $st ($i64) [$r28 + 0] $r16
    $ld ($i64) $r18 [$r17 + 0]
    $ld ($i64) $r20 [$r19 + 0]
    + $r21 ($i64) $r0 $r16
;
||
    $dot $accumulate $r21 ($vi16) $r18 $r20
;
||
    $st ($i64) [$r22 + 0] $r21
    $ld ($i64) $r24 [$r23 + 0]
;
||
    $st ($i64) [$r29 + 0] $r24
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
