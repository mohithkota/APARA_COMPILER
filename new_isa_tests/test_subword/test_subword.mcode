;
||
    $st ($i32) [$r28 + 160] $r30
;
||
    $set $r30 0 2000
;
||
    $st ($i32) [$r28 + 168] $r30
;
||
    $set $r30 0 3000
;
||
    $st ($i32) [$r28 + 176] $r30
;
||
    $set $r30 0 4000
;
||
    $st ($i32) [$r28 + 184] $r30
;
||
    + $r30 ($i64) $r0 5
;
||
    $st ($i8) [$r28 + 192] $r30
;
||
    $set $r30 0 1000
;
||
    $st ($i16) [$r28 + 200] $r30
;
||
    $set $r30 0 34464
;
||
    | $r30 ($i64) $r30 $r31
;
||
    $st ($i32) [$r28 + 208] $r30
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 832
    + $r2 ($i64) $r0 7
    + $r8 ($i64) $r0 9
    + $r9 ($i64) $r0 8
    + $r17 ($i64) $r0 24
    + $r29 ($i64) $r0 48
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r10 ($i64) $r9 0
    + $r18 ($i64) $r17 0
    + $r17 ($i64) $r0 250
    + $r30 ($i64) $r29 0
    $set $r29 0 9999
;
||
    + $r1 ($i64) $r26 -8
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -8
    + $r10 ($i64) $r28 $r10
    + $r14 ($i64) $r26 -16
    + $r15 ($i64) $r26 -16
    + $r18 ($i64) $r28 $r18
    + $r23 ($i64) $r26 -24
;
||
    $st ($i8) [$r1 + 0] $r2
    + $r24 ($i64) $r26 -24
    + $r30 ($i64) $r28 $r30
;
||
    + $r2 ($i64) $r26 -8
;
||
    $ld ($i8) $r3 [$r2 + 0]
;
||
    + $r4 ($i64) $r3 1
    + $r3 ($i64) $r0 72
;
||
    $st ($i8) [$r5 + 0] $r4
    $ld ($i8) $r7 [$r6 + 0]
;
||
    $st ($i64) [$r28 + 0] $r7
    $st ($i8) [$r28 + 96] $r8
    + $r5 ($i64) $r3 0
    + $r6 ($i64) $r0 80
;
||
    $ld ($i8) $r8 [$r28 + 96]
    + $r5 ($i64) $r28 $r5
    + $r7 ($i64) $r6 0
;
||
    $st ($i64) [$r10 + 0] $r8
    + $r7 ($i64) $r28 $r7
;
||
    + $r10 ($i64) $r0 24
;
||
