    << $r31 ($i64) $r31 16
;
||
    + $r30 ($i64) $r0 2
;
||
    $st ($i8) [$r28 + 104] $r30
;
||
    + $r30 ($i64) $r0 3
;
||
    $st ($i8) [$r28 + 112] $r30
;
||
    + $r30 ($i64) $r0 4
;
||
    $st ($i8) [$r28 + 120] $r30
;
||
    + $r30 ($i64) $r0 100
;
||
    $st ($i16) [$r28 + 128] $r30
;
||
    + $r30 ($i64) $r0 200
;
||
    $st ($i16) [$r28 + 136] $r30
;
||
    + $r30 ($i64) $r0 300
;
||
    $st ($i16) [$r28 + 144] $r30
;
||
