;
||
    + $r11 ($i64) $r26 -16
    + $r10 ($i64) $r9 0
;
||
    $ld ($i16) $r12 [$r11 + 0]
    + $r10 ($i64) $r28 $r10
;
||
    + $r13 ($i64) $r12 25
;
||
    $st ($i16) [$r14 + 0] $r13
    $ld ($i16) $r16 [$r15 + 0]
;
||
    $st ($i64) [$r18 + 0] $r16
;
||
    + $r18 ($i64) $r0 8
;
||
    + $r19 ($i64) $r18 128
    + $r18 ($i64) $r0 8
;
||
    + $r19 ($i64) $r28 $r19
;
||
    $st ($i16) [$r19 + 0] $r17
;
||
    + $r19 ($i64) $r18 128
    + $r18 ($i64) $r0 32
;
||
    + $r19 ($i64) $r28 $r19
;
||
    $ld ($i16) $r17 [$r19 + 0]
;
||
    + $r19 ($i64) $r18 0
;
||
    + $r19 ($i64) $r28 $r19
;
||
    $st ($i64) [$r19 + 0] $r17
;
||
    + $r19 ($i64) $r0 16
;
||
    + $r20 ($i64) $r19 128
    + $r19 ($i64) $r0 40
;
||
    + $r20 ($i64) $r28 $r20
;
||
    $ld ($i16) $r18 [$r20 + 0]
;
||
    + $r20 ($i64) $r19 0
    + $r19 ($i64) $r26 -24
