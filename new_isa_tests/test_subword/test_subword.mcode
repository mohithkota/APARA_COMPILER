;
||
    $st ($i32) [$r23 + 0] $r22
    $ld ($i32) $r25 [$r24 + 0]
;
||
    $st ($i64) [$r30 + 0] $r25
    $st ($i32) [$r28 + 160] $r29
;
||
    $ld ($i32) $r29 [$r28 + 160]
    + $r30 ($i64) $r0 56
;
||
    + $r31 ($i64) $r30 0
;
||
    + $r31 ($i64) $r28 $r31
;
||
    $st ($i64) [$r31 + 0] $r29
;
||
    + $r31 ($i64) $r0 24
;
||
    + $r1 ($i64) $r31 160
    + $r31 ($i64) $r0 64
;
||
    + $r1 ($i64) $r28 $r1
;
||
    $ld ($i32) $r30 [$r1 + 0]
;
||
    + $r1 ($i64) $r31 0
;
||
    + $r1 ($i64) $r28 $r1
;
||
    $st ($i64) [$r1 + 0] $r30
    $ld ($i8) $r31 [$r28 + 192]
;
||
    + $r1 ($i64) $r31 1
;
||
    $st ($i8) [$r28 + 192] $r1
;
||
    $ld ($i8) $r2 [$r28 + 192]
    + $r1 ($i64) $r0 1
;
||
    $st ($i64) [$r5 + 0] $r2
    $ld ($i16) $r3 [$r28 + 200]
;
||
    + $r5 ($i64) $r3 1
;
||
    $st ($i16) [$r28 + 200] $r5
;
||
    $ld ($i16) $r4 [$r28 + 200]
;
||
    $st ($i64) [$r7 + 0] $r4
    $ld ($i32) $r6 [$r28 + 208]
;
||
    + $r7 ($i64) $r6 1
;
||
    $st ($i32) [$r28 + 208] $r7
;
||
    $ld ($i32) $r8 [$r28 + 208]
;
||
    $st ($i64) [$r10 + 0] $r8
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
