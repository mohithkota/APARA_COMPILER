// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
    + $r30 ($i64) $r0 100
;
||
    + $r26 ($i64) $r0 $r27
    $st ($i16) [$r28 + 0] $r30
;
||
    + $r30 ($i64) $r0 200
;
||
    $st ($i16) [$r28 + 8] $r30
;
||
    + $r30 ($i64) $r0 300
;
||
    $st ($i16) [$r28 + 16] $r30
;
||
    + $r30 ($i64) $r0 400
;
||
    $st ($i16) [$r28 + 24] $r30
;
||
    $set $r30 0 1000
;
||
    $st ($i16) [$r28 + 32] $r30
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    + $r2 ($i64) $r0 50
    + $r8 ($i64) $r0 75
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -8
;
||
    $st ($i16) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
;
||
    $ld ($i16) $r3 [$r2 + 0]
;
||
    + $r4 ($i64) $r3 25
;
||
    $st ($i16) [$r5 + 0] $r4
    $ld ($i16) $r7 [$r6 + 0]
;
||
    - $r9 ($i64) $r7 $r8
;
||
    ? ($i64) $r9 != $goto if_t_1
;
||
    ? ($i64) $r0 == $goto if_e_2
;
if_t_1:
||
    + $r8 ($i64) $r0 -1
;
||
    + $r1 ($i64) $r0 $r8
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_2:
||
    + $r9 ($i64) $r0 250
    + $r10 ($i64) $r0 8
;
||
    + $r11 ($i64) $r10 0
    + $r10 ($i64) $r0 8
;
||
    + $r11 ($i64) $r28 $r11
;
||
    $st ($i16) [$r11 + 0] $r9
;
||
    + $r11 ($i64) $r10 0
    + $r10 ($i64) $r0 250
;
||
    + $r11 ($i64) $r28 $r11
;
||
    $ld ($i16) $r9 [$r11 + 0]
;
||
    - $r11 ($i64) $r9 $r10
;
||
    ? ($i64) $r11 != $goto if_t_3
;
||
    ? ($i64) $r0 == $goto if_e_4
;
if_t_3:
||
    + $r10 ($i64) $r0 -2
;
||
    + $r1 ($i64) $r0 $r10
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_4:
||
    + $r12 ($i64) $r0 16
;
||
    + $r13 ($i64) $r12 0
    + $r12 ($i64) $r0 300
;
||
    + $r13 ($i64) $r28 $r13
;
||
    $ld ($i16) $r11 [$r13 + 0]
;
||
    - $r13 ($i64) $r11 $r12
;
||
    ? ($i64) $r13 != $goto if_t_5
;
||
    ? ($i64) $r0 == $goto if_e_6
;
if_t_5:
||
    + $r12 ($i64) $r0 -3
;
||
    + $r1 ($i64) $r0 $r12
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_6:
||
    $ld ($i16) $r13 [$r28 + 32]
    $set $r16 0 1001
;
||
    + $r14 ($i64) $r13 1
;
||
    $st ($i16) [$r28 + 32] $r14
;
||
    $ld ($i16) $r15 [$r28 + 32]
;
||
    - $r17 ($i64) $r15 $r16
;
||
    ? ($i64) $r17 != $goto if_t_7
;
||
    ? ($i64) $r0 == $goto if_e_8
;
if_t_7:
||
    + $r16 ($i64) $r0 -4
;
||
    + $r1 ($i64) $r0 $r16
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_8:
||
    $ld ($i16) $r17 [$r28 + 0]
    + $r18 ($i64) $r26 -16
    + $r20 ($i64) $r0 24
    + $r23 ($i64) $r26 -24
    + $r29 ($i64) $r26 -32
    + $r30 ($i64) $r26 -32
    + $r1 ($i64) $r0 500
;
||
    $st ($i16) [$r18 + 0] $r17
    + $r21 ($i64) $r20 0
    + $r20 ($i64) $r26 -24
;
||
    + $r21 ($i64) $r28 $r21
;
||
    $ld ($i16) $r19 [$r21 + 0]
;
||
    $st ($i16) [$r20 + 0] $r19
    + $r21 ($i64) $r26 -16
    $ld ($i16) $r24 [$r23 + 0]
;
||
    $ld ($i16) $r22 [$r21 + 0]
;
||
    + $r25 ($i64) $r22 $r24
;
||
    $st ($i16) [$r29 + 0] $r25
    $ld ($i16) $r31 [$r30 + 0]
;
||
    - $r2 ($i64) $r31 $r1
;
||
    ? ($i64) $r2 != $goto if_t_9
;
||
    ? ($i64) $r0 == $goto if_e_10
;
if_t_9:
||
    + $r1 ($i64) $r0 -5
;
||
    + $r1 ($i64) $r0 $r1
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_10:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
