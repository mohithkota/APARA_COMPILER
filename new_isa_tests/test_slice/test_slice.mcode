// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 816
    $set $r2 0 43981
    + $r6 ($i64) $r0 8
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r7 ($i64) $r6 0
;
||
    + $r1 ($i64) $r26 -8
    + $r7 ($i64) $r28 $r7
;
||
    $st ($i64) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -8
    + $r1 ($i64) $r0 1
;
||
    $ld ($i64) $r3 [$r2 + 0]
;
||
    $slice $r4 7 4 $r3
    $slice $r5 15 8 $r3
;
||
    $st ($i64) [$r28 + 0] $r4
    $st ($i64) [$r7 + 0] $r5
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
