// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 856
    + $r2 ($i64) $r0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
;
||
    + $r1 ($i64) $r26 -8
    + $r3 ($i64) $r26 -8
    + $r4 ($i64) $r26 -8
    + $r5 ($i64) $r26 -8
    + $r6 ($i64) $r26 -8
;
||
    $st ($i32) [$r1 + 0] $r2
    $ld ($i32) $r7 [$r6 + 0]
;
||
    + $r2 ($i64) $r26 -8
;
fc_1:
||
    + $r8 ($i64) $r0 $r7
    + $r9 ($i64) $r0 16
;
||
    - $r10 ($i64) $r9 $r8
;
||
    ? ($i64) $r10 > $goto fb_2
;
||
    ? ($i64) $r0 == $goto fe_4
;
fb_2:
||
    + $r9 ($i64) $r0 $r7
;
||
    + $r10 ($i64) $r9 1
    * $r11 ($i64) $r9 8
;
||
    + $r12 ($i64) $r11 0
    + $r13 ($i64) $r11 128
;
||
    + $r12 ($i64) $r28 $r12
    + $r13 ($i64) $r28 $r13
;
||
    $st ($i8) [$r12 + 0] $r10
;
||
    + $r12 ($i64) $r0 1
;
||
    $st ($i8) [$r13 + 0] $r12
;
fi_3:
||
    + $r12 ($i64) $r0 $r7
;
||
    + $r13 ($i64) $r0 $r12
    + $r14 ($i64) $r12 1
;
||
    + $r7 ($i64) $r0 $r14
    ? ($i64) $r0 == $goto fc_1
;
fe_4:
||
    + $r15 ($i64) $r26 -8
    + $r16 ($i64) $r28 256
    + $r17 ($i64) $r28 0
    + $r21 ($i64) $r0 8
    + $r23 ($i64) $r28 128
    + $r30 ($i64) $r0 8
    + $r8 ($i64) $r26 -24
    + $r11 ($i64) $r26 -48
;
||
    $st ($i32) [$r15 + 0] $r7
    $ld ($u128) $r6 [$r17 + 0]
    + $r22 ($i64) $r21 256
    + $r21 ($i64) $r26 -24
    + $r31 ($i64) $r30 256
    + $r30 ($i64) $r26 -40
    + $r12 ($i64) $r0 136
;
||
    + $r18 ($i64) $r0 $r6
    + $r19 ($i64) $r0 $r7
    + $r7 ($i64) $r26 -16
    + $r22 ($i64) $r28 $r22
    + $r31 ($i64) $r28 $r31
;
||
    $st ($i64) [$r16 + 0] $r18
    $st ($i64) [$r16 + 8] $r19
    $ld ($i64) $r6 [$r28 + 256]
;
||
    $st ($i64) [$r7 + 0] $r6
    $ld ($i64) $r20 [$r22 + 0]
;
||
    $st ($i64) [$r21 + 0] $r20
    + $r22 ($i64) $r28 256
    $ld ($u128) $r6 [$r23 + 0]
;
||
    + $r24 ($i64) $r0 $r6
    + $r25 ($i64) $r0 $r7
    + $r7 ($i64) $r26 -32
;
||
    $st ($i64) [$r22 + 0] $r24
    $st ($i64) [$r22 + 8] $r25
    $ld ($i64) $r6 [$r28 + 256]
;
||
    $st ($i64) [$r7 + 0] $r6
    $ld ($i64) $r29 [$r31 + 0]
;
||
    $st ($i64) [$r30 + 0] $r29
    + $r31 ($i64) $r26 -16
    $ld ($i64) $r9 [$r8 + 0]
;
||
    $ld ($i64) $r1 [$r31 + 0]
;
||
    $dot $r10 ($vu8) $r1 $r6
;
||
    $dot $accumulate $r10 ($vu8) $r9 $r29
;
||
    $st ($i64) [$r11 + 0] $r10
    - $r14 ($i64) $r10 $r12
;
||
    ? ($i64) $r14 != $goto if_t_5
;
||
    ? ($i64) $r0 == $goto if_e_6
;
if_t_5:
||
    + $r12 ($i64) $r0 -1
;
||
    + $r1 ($i64) $r0 $r12
    ? ($i64) $r0 == $goto main_epilogue
;
if_e_6:
||
    + $r1 ($i64) $r0 1
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
