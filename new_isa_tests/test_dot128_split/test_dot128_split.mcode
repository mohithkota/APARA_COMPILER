// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    $set $r2 0 1800
    $set $r3 0 1286
    $set $r4 0 772
    + $r5 ($i64) $r0 258
    $set $r6 0 2314
    + $r7 ($i64) $r0 257
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    << $r7 ($i64) $r7 16
    + $r8 ($i64) $r0 257
    + $r14 ($i64) $r28 0
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    $set $r5 0 2828
    << $r8 ($i64) $r8 16
    + $r9 ($i64) $r26 -24
    + $r11 ($i64) $r26 -32
;
||
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    $set $r6 0 257
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 3342
    << $r5 ($i64) $r5 16
    | $r6 ($i64) $r6 $r7
    $set $r7 0 257
;
||
    << $r3 ($i64) $r3 16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 257
    << $r6 ($i64) $r6 16
    | $r7 ($i64) $r7 $r8
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 3856
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    $set $r6 0 257
    << $r7 ($i64) $r7 16
;
||
    $st ($i64) [$r1 + 0] $r2
    | $r3 ($i64) $r3 $r4
    $set $r4 0 257
    << $r5 ($i64) $r5 16
    | $r6 ($i64) $r6 $r7
    + $r7 ($i64) $r26 -16
;
||
    + $r2 ($i64) $r26 -16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 257
    << $r6 ($i64) $r6 16
    + $r1 ($i64) $r0 1
;
||
    $st ($i64) [$r2 + 0] $r3
    | $r5 ($i64) $r5 $r6
;
||
    + $r3 ($i64) $r26 -24
;
||
    $st ($i64) [$r3 + 0] $r4
;
||
    + $r4 ($i64) $r26 -32
;
||
    $st ($i64) [$r4 + 0] $r5
    $ld ($i64) $r8 [$r7 + 0]
    $ld ($i64) $r10 [$r9 + 0]
    $ld ($i64) $r12 [$r11 + 0]
;
||
    + $r5 ($i64) $r26 -8
;
||
    $ld ($i64) $r6 [$r5 + 0]
;
||
    $dot $r13 ($vu8) $r6 $r10
;
||
    $dot $accumulate $r13 ($vu8) $r8 $r12
;
||
    $st ($i64) [$r14 + 0] $r13
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
