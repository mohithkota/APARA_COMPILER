// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 856
    $set $r2 0 0
    + $r3 ($i64) $r0 2
    $set $r4 0 0
    $set $r5 0 0
    + $r6 ($i64) $r0 4
    $set $r12 0 0
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    $set $r1 0 0
    << $r3 ($i64) $r3 16
    << $r6 ($i64) $r6 16
    + $r13 ($i64) $r0 20
    + $r14 ($i64) $r0 10
    $set $r15 0 0
;
||
    | $r2 ($i64) $r2 $r3
    + $r3 ($i64) $r0 1
    | $r5 ($i64) $r5 $r6
    + $r6 ($i64) $r0 3
    + $r7 ($i64) $r26 -8
    + $r9 ($i64) $r26 -16
    << $r13 ($i64) $r13 16
    + $r16 ($i64) $r0 30
;
||
    << $r2 ($i64) $r2 16
    << $r5 ($i64) $r5 16
    | $r12 ($i64) $r12 $r13
    << $r16 ($i64) $r16 16
    $set $r17 0 0
    $set $r18 0 0
    + $r19 ($i64) $r0 40
    + $r20 ($i64) $r0 2
;
||
    | $r1 ($i64) $r1 $r2
    | $r4 ($i64) $r4 $r5
    | $r13 ($i64) $r14 $r12
    $set $r14 0 0
    | $r15 ($i64) $r15 $r16
    $set $r16 0 0
    << $r19 ($i64) $r19 16
    << $r20 ($i64) $r20 16
;
||
    | $r2 ($i64) $r3 $r1
    + $r3 ($i64) $r26 -8
    | $r5 ($i64) $r6 $r4
    + $r6 ($i64) $r26 -16
    << $r15 ($i64) $r15 16
    | $r18 ($i64) $r18 $r19
    $set $r19 0 0
    + $r21 ($i64) $r0 1
;
||
    $st ($i64) [$r3 + 0] $r2
    $st ($i64) [$r6 + 0] $r5
    $ld ($i64) $r8 [$r7 + 0]
    $ld ($i64) $r10 [$r9 + 0]
    | $r14 ($i64) $r14 $r15
    << $r18 ($i64) $r18 16
    | $r19 ($i64) $r19 $r20
    $set $r22 0 0
;
||
    $v + $r11 ($vi32) $r8 $r10
    | $r15 ($i64) $r13 $r14
    | $r17 ($i64) $r17 $r18
    + $r18 ($i64) $r26 -24
    | $r20 ($i64) $r21 $r19
    $set $r21 0 0
    + $r23 ($i64) $r0 3
    $set $r24 0 0
;
||
    $st ($i64) [$r28 + 0] $r11
    << $r17 ($i64) $r17 16
    << $r23 ($i64) $r23 16
    $set $r25 0 0
    + $r29 ($i64) $r0 4
    + $r31 ($i64) $r26 -32
    + $r2 ($i64) $r0 8
    + $r6 ($i64) $r0 2
;
||
    | $r16 ($i64) $r16 $r17
    | $r22 ($i64) $r22 $r23
    $set $r23 0 0
    << $r29 ($i64) $r29 16
    + $r4 ($i64) $r2 0
    $set $r2 0 768
    + $r5 ($i64) $r0 4
    $set $r7 0 0
;
||
    | $r17 ($i64) $r15 $r16
    << $r22 ($i64) $r22 16
    | $r25 ($i64) $r25 $r29
    + $r29 ($i64) $r26 -24
    + $r4 ($i64) $r28 $r4
    << $r5 ($i64) $r5 16
    $set $r9 0 1280
    + $r8 ($i64) $r26 -40
;
||
    $st ($i64) [$r18 + 0] $r17
    | $r21 ($i64) $r21 $r22
    << $r25 ($i64) $r25 16
    << $r9 ($i64) $r9 16
    $set $r10 0 512
    + $r12 ($i64) $r0 2
    $set $r13 0 0
    $set $r14 0 512
;
||
    | $r22 ($i64) $r20 $r21
    | $r24 ($i64) $r24 $r25
    + $r25 ($i64) $r26 -32
    | $r7 ($i64) $r7 $r9
    | $r11 ($i64) $r12 $r10
    << $r14 ($i64) $r14 16
    + $r15 ($i64) $r26 -48
    + $r16 ($i64) $r26 -40
;
||
    << $r24 ($i64) $r24 16
    | $r12 ($i64) $r11 $r19
    | $r13 ($i64) $r13 $r14
    + $r17 ($i64) $r26 -48
;
||
    | $r23 ($i64) $r23 $r24
    | $r14 ($i64) $r12 $r13
;
||
    | $r24 ($i64) $r22 $r23
    + $r22 ($i64) $r0 16
;
||
    $st ($i64) [$r25 + 0] $r24
    $ld ($i64) $r30 [$r29 + 0]
    $ld ($i64) $r1 [$r31 + 0]
    + $r23 ($i64) $r22 0
    + $r22 ($i64) $r26 -8
;
||
    $v - $r3 ($vi16) $r30 $r1
    + $r23 ($i64) $r28 $r23
    + $r24 ($i64) $r0 10
    + $r1 ($i64) $r0 1
;
||
    $st ($i64) [$r4 + 0] $r3
;
||
    | $r4 ($i64) $r6 $r2
    $set $r6 0 0
;
||
    | $r6 ($i64) $r6 $r5
;
||
    | $r5 ($i64) $r4 $r6
;
||
    | $r9 ($i64) $r5 $r7
;
||
    $st ($i64) [$r8 + 0] $r9
    $st ($i64) [$r15 + 0] $r14
    $ld ($i64) $r18 [$r16 + 0]
    $ld ($i64) $r20 [$r17 + 0]
;
||
    $v * $r21 ($vi8) $r18 $r20
;
||
    $st ($i64) [$r23 + 0] $r21
    $ld ($i64) $r23 [$r22 + 0]
;
||
    $v + $r25 ($vi32) $r23 $r24 $replicate
    + $r24 ($i64) $r0 24
;
||
    + $r29 ($i64) $r24 0
;
||
    + $r29 ($i64) $r28 $r29
;
||
    $st ($i64) [$r29 + 0] $r25
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
