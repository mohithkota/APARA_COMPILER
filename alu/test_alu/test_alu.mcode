// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
    + $r30 ($i64) $r0 10
;
||
    + $r26 ($i64) $r0 $r27
    $st ($i64) [$r28 + 0] $r30
;
||
    + $r30 ($i64) $r0 3
;
||
    $st ($i64) [$r28 + 8] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 16] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 24] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 32] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 40] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 48] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 56] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 64] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 72] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 80] $r30
;
||
    + $r30 ($i64) $r0 0
;
||
    $st ($i64) [$r28 + 88] $r30
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 808
    $ld ($i64) $r2 [$r28 + 8]
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    $ld ($i64) $r1 [$r28 + 0]
;
||
    + $r3 ($i64) $r1 $r2
    - $r4 ($i64) $r1 $r2
    * $r5 ($i64) $r1 $r2
    / $r6 ($i64) $r1 $r2
    / $r8 ($i64) $r1 $r2
    | $r9 ($i64) $r1 $r2
    ^ $r10 ($i64) $r1 $r2
    << $r11 ($i64) $r1 $r2
;
||
    $st ($i64) [$r28 + 16] $r3
    $st ($i64) [$r28 + 24] $r4
    $st ($i64) [$r28 + 32] $r5
    $st ($i64) [$r28 + 40] $r6
    * $r8 ($i64) $r8 $r2
    >> $r12 ($i64) $r1 $r2
;
||
    - $r7 ($i64) $r1 $r8
    & $r8 ($i64) $r1 $r2
    + $r1 ($i64) $r0 $r3
;
||
    $st ($i64) [$r28 + 48] $r7
    $st ($i64) [$r28 + 56] $r8
    $st ($i64) [$r28 + 64] $r9
    $st ($i64) [$r28 + 72] $r10
    $st ($i64) [$r28 + 80] $r11
    $st ($i64) [$r28 + 88] $r12
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
