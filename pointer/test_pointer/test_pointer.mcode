;
||
    $st ($i64) [$r7 + 0] $r5
;
||
    + $r5 ($i64) $r28 80
;
||
    $st ($i64) [$r6 + 0] $r5
    $ld ($i64) $r7 [$r5 + 0]
;
||
    $st ($i64) [$r9 + 0] $r7
    $ld ($i64) $r8 [$r5 + 8]
