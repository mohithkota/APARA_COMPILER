||
    + $r5 ($i64) $r0 5
    + $r9 ($i64) $r10 80
    + $r10 ($i64) $r26 -16
;
||
    + $r9 ($i64) $r28 $r9
;
||
    $st ($i64) [$r9 + 0] $r5
;
||
    + $r5 ($i64) $r28 80
    + $r9 ($i64) $r26 -32
;
||
    $st ($i64) [$r10 + 0] $r5
    $st ($i32) [$r9 + 0] $r11
    $ld ($i32) $r21 [$r18 + 0]
    $ld ($i64) $r22 [$r20 + 0]
    $ld ($i64) $r23 [$r24 + 0]
;
||
    + $r11 ($i64) $r26 -32
;
fc_1:
||
    + $r25 ($i64) $r0 $r21
    + $r30 ($i64) $r0 5
;
||
    - $r29 ($i64) $r30 $r25
;
||
    ? ($i64) $r29 > $goto fb_2
;
||
    ? ($i64) $r0 == $goto fe_4
