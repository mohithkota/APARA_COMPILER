// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    + $r2 ($i64) $r0 42
    + $r5 ($i64) $r0 10
    + $r6 ($i64) $r0 8
    + $r8 ($i64) $r0 8
    + $r12 ($i64) $r0 24
    + $r18 ($i64) $r0 32
;
||
