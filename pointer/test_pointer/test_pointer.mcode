    + $r24 ($i64) $r23 0
    + $r23 ($i64) $r28 80
    + $r30 ($i64) $r29 0
    + $r1 ($i64) $r0 56
;
||
    $st ($i64) [$r3 + 0] $r2
    $ld ($i64) $r4 [$r2 + 0]
    + $r24 ($i64) $r28 $r24
    + $r30 ($i64) $r28 $r30
;
||
    $st ($i64) [$r28 + 0] $r4
