;
||
    + $r9 ($i64) $r0 16
;
||
    + $r10 ($i64) $r9 0
    + $r9 ($i64) $r5 16
;
||
    + $r10 ($i64) $r28 $r10
;
||
    $st ($i64) [$r10 + 0] $r8
;
||
    + $r10 ($i64) $r26 -16
    + $r8 ($i64) $r0 64
;
||
    $st ($i64) [$r10 + 0] $r9
    $ld ($i64) $r11 [$r9 + 0]
