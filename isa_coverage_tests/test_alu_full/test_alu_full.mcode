// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 840
    + $r2 ($i64) $r0 17
    + $r3 ($i64) $r0 5
    + $r9 ($i64) $r0 8
    + $r14 ($i64) $r0 10
    + $r19 ($i64) $r0 40
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r10 ($i64) $r9 0
    + $r20 ($i64) $r19 0
;
||
    + $r1 ($i64) $r26 -8
    + $r5 ($i64) $r26 -16
    + $r10 ($i64) $r28 $r10
    + $r16 ($i64) $r26 -32
    + $r20 ($i64) $r28 $r20
;
||
    $st ($i64) [$r1 + 0] $r2
;
||
    + $r2 ($i64) $r26 -16
    + $r1 ($i64) $r0 1
;
||
    $st ($i64) [$r2 + 0] $r3
    $ld ($i64) $r6 [$r5 + 0]
;
||
    + $r3 ($i64) $r26 -8
;
||
    $ld ($i64) $r4 [$r3 + 0]
;
||
    + $r7 ($i64) $r4 $r6
    - $r8 ($i64) $r4 $r6
    * $r9 ($i64) $r4 $r6
;
||
    $st ($i64) [$r28 + 0] $r7
    $st ($i64) [$r10 + 0] $r8
;
||
    + $r10 ($i64) $r0 16
;
||
    + $r11 ($i64) $r10 0
    / $r10 ($i64) $r4 $r6
;
||
    + $r11 ($i64) $r28 $r11
;
||
    $st ($i64) [$r11 + 0] $r9
;
||
    + $r11 ($i64) $r0 24
;
||
    + $r12 ($i64) $r11 0
;
||
    + $r12 ($i64) $r28 $r12
;
||
    $st ($i64) [$r12 + 0] $r10
;
||
    / $r12 ($i64) $r4 $r6
;
||
    * $r12 ($i64) $r12 $r6
;
||
    - $r11 ($i64) $r4 $r12
    + $r12 ($i64) $r0 32
;
||
    + $r13 ($i64) $r12 0
    + $r12 ($i64) $r26 -24
;
||
    + $r13 ($i64) $r28 $r13
;
||
    $st ($i64) [$r13 + 0] $r11
;
||
    + $r13 ($i64) $r0 12
;
||
    $st ($i64) [$r12 + 0] $r13
;
||
    + $r13 ($i64) $r26 -32
;
||
    $st ($i64) [$r13 + 0] $r14
    $ld ($i64) $r17 [$r16 + 0]
;
||
    + $r14 ($i64) $r26 -24
;
||
    $ld ($i64) $r15 [$r14 + 0]
;
||
    & $r18 ($i64) $r15 $r17
    | $r19 ($i64) $r15 $r17
;
||
    $st ($i64) [$r20 + 0] $r18
;
||
    + $r20 ($i64) $r0 48
;
||
    + $r21 ($i64) $r20 0
    ^ $r20 ($i64) $r15 $r17
;
||
    + $r21 ($i64) $r28 $r21
;
||
    $st ($i64) [$r21 + 0] $r19
;
||
    + $r21 ($i64) $r0 56
;
||
    + $r22 ($i64) $r21 0
    << $r21 ($i64) $r15 2
;
||
    + $r22 ($i64) $r28 $r22
;
||
    $st ($i64) [$r22 + 0] $r20
;
||
    + $r22 ($i64) $r0 64
;
||
    + $r23 ($i64) $r22 0
    >> $r22 ($i64) $r15 1
;
||
    + $r23 ($i64) $r28 $r23
;
||
    $st ($i64) [$r23 + 0] $r21
;
||
    + $r23 ($i64) $r0 72
;
||
    + $r24 ($i64) $r23 0
    ~& $r23 ($i64) $r15 $r17
;
||
    + $r24 ($i64) $r28 $r24
;
||
    $st ($i64) [$r24 + 0] $r22
;
||
    + $r24 ($i64) $r0 80
;
||
    + $r25 ($i64) $r24 0
    ~| $r24 ($i64) $r15 $r17
;
||
    + $r25 ($i64) $r28 $r25
;
||
    $st ($i64) [$r25 + 0] $r23
;
||
    + $r25 ($i64) $r0 88
;
||
    + $r29 ($i64) $r25 0
    ~^ $r25 ($i64) $r15 $r17
;
||
    + $r29 ($i64) $r28 $r29
;
||
    $st ($i64) [$r29 + 0] $r24
;
||
    + $r29 ($i64) $r0 96
;
||
    + $r30 ($i64) $r29 0
;
||
    + $r30 ($i64) $r28 $r30
;
||
    $st ($i64) [$r30 + 0] $r25
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
