// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 824
    $set $r2 0 47768
    $set $r3 0 65244
    + $r6 ($i64) $r0 8
    $set $r14 0 39612
    $set $r15 0 22136
    $set $r16 0 4660
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r3 ($i64) $r3 16
    + $r7 ($i64) $r6 0
    << $r16 ($i64) $r16 16
;
||
    + $r1 ($i64) $r26 -8
    | $r2 ($i64) $r2 $r3
    + $r7 ($i64) $r28 $r7
    | $r15 ($i64) $r15 $r16
    + $r16 ($i64) $r0 64
;
||
    $st ($i64) [$r1 + 0] $r2
    << $r15 ($i64) $r15 16
    + $r17 ($i64) $r16 0
;
||
    + $r2 ($i64) $r26 -8
    | $r14 ($i64) $r14 $r15
    + $r17 ($i64) $r28 $r17
    + $r1 ($i64) $r0 1
;
||
    $ld ($i64) $r3 [$r2 + 0]
    << $r14 ($i64) $r14 16
;
||
    $slice $r4 3 0 $r3
    $slice $r5 7 4 $r3
    $slice $r6 7 0 $r3
;
||
    $st ($i64) [$r28 + 0] $r4
    $st ($i64) [$r7 + 0] $r5
;
||
    + $r7 ($i64) $r0 16
;
||
    + $r8 ($i64) $r7 0
    $slice $r7 15 8 $r3
;
||
    + $r8 ($i64) $r28 $r8
;
||
    $st ($i64) [$r8 + 0] $r6
;
||
    + $r8 ($i64) $r0 24
;
||
    + $r9 ($i64) $r8 0
    $slice $r8 31 24 $r3
;
||
    + $r9 ($i64) $r28 $r9
;
||
    $st ($i64) [$r9 + 0] $r7
;
||
    + $r9 ($i64) $r0 32
;
||
    + $r10 ($i64) $r9 0
    $slice $r9 15 0 $r3
;
||
    + $r10 ($i64) $r28 $r10
;
||
    $st ($i64) [$r10 + 0] $r8
;
||
    + $r10 ($i64) $r0 40
;
||
    + $r11 ($i64) $r10 0
    $slice $r10 31 16 $r3
;
||
    + $r11 ($i64) $r28 $r11
;
||
    $st ($i64) [$r11 + 0] $r9
;
||
    + $r11 ($i64) $r0 48
;
||
    + $r12 ($i64) $r11 0
    $slice $r11 10 3 $r3
;
||
    + $r12 ($i64) $r28 $r12
;
||
    $st ($i64) [$r12 + 0] $r10
;
||
    + $r12 ($i64) $r0 56
;
||
    + $r13 ($i64) $r12 0
    + $r12 ($i64) $r26 -16
;
||
    + $r13 ($i64) $r28 $r13
;
||
    $st ($i64) [$r13 + 0] $r11
;
||
    $set $r13 0 57072
;
||
    | $r13 ($i64) $r13 $r14
;
||
    $st ($i64) [$r12 + 0] $r13
;
||
    + $r13 ($i64) $r26 -16
;
||
    $ld ($i64) $r14 [$r13 + 0]
;
||
    $slice $r15 31 0 $r14
    $slice $r16 63 32 $r14
;
||
    $st ($i64) [$r17 + 0] $r15
;
||
    + $r17 ($i64) $r0 72
;
||
    + $r18 ($i64) $r17 0
;
||
    + $r18 ($i64) $r28 $r18
;
||
    $st ($i64) [$r18 + 0] $r16
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
