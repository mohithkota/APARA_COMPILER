// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 856
    + $r7 ($i64) $r0 8
    + $r11 ($i64) $r0 16
    + $r15 ($i64) $r0 32
    + $r20 ($i64) $r0 48
    + $r24 ($i64) $r0 64
    $set $r30 0 45776
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r1 ($i64) $r0 -1
    + $r8 ($i64) $r7 0
    + $r12 ($i64) $r11 0
    + $r16 ($i64) $r15 0
    + $r21 ($i64) $r20 0
    + $r25 ($i64) $r24 0
;
||
    + $r2 ($i64) $r26 -8
    + $r3 ($i64) $r26 -8
    + $r8 ($i64) $r28 $r8
    + $r7 ($i64) $r26 -16
    + $r12 ($i64) $r28 $r12
    + $r16 ($i64) $r28 $r16
    + $r21 ($i64) $r28 $r21
    + $r25 ($i64) $r28 $r25
;
||
    $st ($i64) [$r2 + 0] $r1
    $ld ($i64) $r4 [$r3 + 0]
    << $r30 ($i64) $r30 16
;
||
    $cast ($i64) $r5 ($i8) $r4
    $cast ($i64) $r6 ($u8) $r4
    + $r2 ($i64) $r0 80
    + $r4 ($i64) $r26 -40
;
||
    $st ($i64) [$r28 + 0] $r5
    $st ($i64) [$r8 + 0] $r6
    + $r1 ($i64) $r2 0
;
||
    + $r8 ($i64) $r0 200
    + $r1 ($i64) $r28 $r1
    + $r6 ($i64) $r26 -16
;
||
    $st ($i64) [$r7 + 0] $r8
;
||
    + $r8 ($i64) $r26 -16
;
||
    $ld ($i64) $r9 [$r8 + 0]
;
||
    $cast ($i64) $r10 ($i8) $r9
    $cast ($i64) $r11 ($u8) $r9
    + $r9 ($i64) $r26 -40
;
||
    $st ($i64) [$r12 + 0] $r10
;
||
    + $r12 ($i64) $r0 24
    + $r10 ($i64) $r26 -48
;
||
    + $r13 ($i64) $r12 0
    + $r12 ($i64) $r26 -8
;
||
    + $r13 ($i64) $r28 $r13
;
||
    $st ($i64) [$r13 + 0] $r11
    $ld ($i64) $r13 [$r12 + 0]
;
||
    $cast ($i64) $r14 ($i16) $r13
    $cast ($i64) $r15 ($u16) $r13
    + $r12 ($i64) $r0 96
    + $r13 ($i64) $r0 104
;
||
    $st ($i64) [$r16 + 0] $r14
;
||
    + $r16 ($i64) $r0 40
    + $r14 ($i64) $r12 0
    + $r12 ($i64) $r26 -48
;
||
    + $r17 ($i64) $r16 0
    + $r16 ($i64) $r26 -24
    + $r14 ($i64) $r28 $r14
;
||
    + $r17 ($i64) $r28 $r17
;
||
    $st ($i64) [$r17 + 0] $r15
;
||
    $set $r17 0 40000
    + $r15 ($i64) $r13 0
;
||
    $st ($i64) [$r16 + 0] $r17
    + $r15 ($i64) $r28 $r15
;
||
    + $r17 ($i64) $r26 -24
;
||
    $ld ($i64) $r18 [$r17 + 0]
;
||
    $cast ($i64) $r19 ($i16) $r18
    $cast ($i64) $r20 ($u16) $r18
;
||
    $st ($i64) [$r21 + 0] $r19
;
||
    + $r21 ($i64) $r0 56
;
||
    + $r22 ($i64) $r21 0
    + $r21 ($i64) $r26 -8
;
||
    + $r22 ($i64) $r28 $r22
;
||
    $st ($i64) [$r22 + 0] $r20
    $ld ($i64) $r22 [$r21 + 0]
;
||
    $cast ($i64) $r23 ($i32) $r22
    $cast ($i64) $r24 ($u32) $r22
;
||
    $st ($i64) [$r25 + 0] $r23
;
||
    + $r25 ($i64) $r0 72
;
||
    + $r29 ($i64) $r25 0
    + $r25 ($i64) $r26 -32
;
||
    + $r29 ($i64) $r28 $r29
;
||
    $st ($i64) [$r29 + 0] $r24
;
||
    $set $r29 0 24064
;
||
    | $r29 ($i64) $r29 $r30
;
||
    $st ($i64) [$r25 + 0] $r29
;
||
    + $r29 ($i64) $r26 -32
;
||
    $ld ($i64) $r30 [$r29 + 0]
;
||
    $cast ($i64) $r31 ($i32) $r30
    $cast ($i64) $r2 ($u32) $r30
;
||
    $st ($i64) [$r1 + 0] $r31
;
||
    + $r1 ($i64) $r0 88
;
||
    + $r3 ($i64) $r1 0
    + $r1 ($i64) $r26 -16
;
||
    + $r3 ($i64) $r28 $r3
;
||
    $st ($i64) [$r3 + 0] $r2
    $ld ($i64) $r3 [$r1 + 0]
;
||
    $cast ($i64) $r5 ($i8) $r3
    + $r1 ($i64) $r0 1
;
||
    $st ($i8) [$r4 + 0] $r5
    $ld ($i64) $r7 [$r6 + 0]
;
||
    $cast ($i64) $r8 ($u8) $r7
;
||
    $st ($i8) [$r10 + 0] $r8
    $ld ($i8) $r11 [$r9 + 0]
;
||
    $st ($i64) [$r14 + 0] $r11
    $ld ($u8) $r14 [$r12 + 0]
;
||
    $st ($i64) [$r15 + 0] $r14
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
