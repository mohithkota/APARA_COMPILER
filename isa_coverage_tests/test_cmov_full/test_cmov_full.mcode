// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 808
    + $r2 ($i64) $r0 5
    $set $r3 0 999
    + $r4 ($i64) $r0 100
    + $r5 ($i64) $r0 100
    $set $r6 0 999
    + $r7 ($i64) $r0 100
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r1 ($i64) $r0 $r3
    $set $r8 0 999
    + $r9 ($i64) $r0 100
    + $r10 ($i64) $r0 100
    + $r11 ($i64) $r0 100
    + $r12 ($i64) $r0 100
;
||
    $cmov ? ($i64) $r2 > $r1 $r4
    + $r2 ($i64) $r0 -5
    $set $r4 0 999
    + $r13 ($i64) $r0 100
    + $r14 ($i64) $r0 100
    + $r15 ($i64) $r0 100
    + $r16 ($i64) $r0 100
    $set $r17 0 999
;
||
    $st ($i64) [$r28 + 0] $r1
    + $r3 ($i64) $r0 $r4
    + $r4 ($i64) $r0 8
    + $r18 ($i64) $r0 100
    + $r19 ($i64) $r0 100
    $set $r20 0 999
    + $r21 ($i64) $r0 100
;
||
    $cmov ? ($i64) $r2 > $r3 $r5
    + $r5 ($i64) $r4 0
    + $r4 ($i64) $r0 -5
    + $r1 ($i64) $r0 1
;
||
    + $r5 ($i64) $r28 $r5
;
||
    $st ($i64) [$r5 + 0] $r3
;
||
    + $r5 ($i64) $r0 $r6
    + $r6 ($i64) $r0 16
;
||
    $cmov ? ($i64) $r4 < $r5 $r7
    + $r7 ($i64) $r6 0
    + $r6 ($i64) $r0 $r8
;
||
    + $r7 ($i64) $r28 $r7
;
||
    $st ($i64) [$r7 + 0] $r5
;
||
    + $r7 ($i64) $r0 5
;
||
    $cmov ? ($i64) $r7 < $r6 $r9
    + $r7 ($i64) $r0 24
    $set $r9 0 999
;
||
    + $r8 ($i64) $r7 0
    + $r7 ($i64) $r0 $r9
;
||
    + $r8 ($i64) $r28 $r8
;
||
    $st ($i64) [$r8 + 0] $r6
;
||
    + $r8 ($i64) $r0 0
;
||
    $cmov ? ($i64) $r8 == $r7 $r10
    + $r8 ($i64) $r0 32
    $set $r10 0 999
;
||
    + $r9 ($i64) $r8 0
    + $r8 ($i64) $r0 $r10
;
||
    + $r9 ($i64) $r28 $r9
;
||
    $st ($i64) [$r9 + 0] $r7
;
||
    + $r9 ($i64) $r0 5
;
||
    $cmov ? ($i64) $r9 == $r8 $r11
    + $r9 ($i64) $r0 40
    $set $r11 0 999
;
||
    + $r10 ($i64) $r9 0
    + $r9 ($i64) $r0 $r11
;
||
    + $r10 ($i64) $r28 $r10
;
||
    $st ($i64) [$r10 + 0] $r8
;
||
    + $r10 ($i64) $r0 5
;
||
    $cmov ? ($i64) $r10 != $r9 $r12
    + $r10 ($i64) $r0 48
    $set $r12 0 999
;
||
    + $r11 ($i64) $r10 0
    + $r10 ($i64) $r0 $r12
;
||
    + $r11 ($i64) $r28 $r11
;
||
    $st ($i64) [$r11 + 0] $r9
;
||
    + $r11 ($i64) $r0 0
;
||
    $cmov ? ($i64) $r11 != $r10 $r13
    + $r11 ($i64) $r0 56
    $set $r13 0 999
;
||
    + $r12 ($i64) $r11 0
    + $r11 ($i64) $r0 $r13
;
||
    + $r12 ($i64) $r28 $r12
;
||
    $st ($i64) [$r12 + 0] $r10
;
||
    + $r12 ($i64) $r0 0
;
||
    $cmov ? ($i64) $r12 >= $r11 $r14
    + $r12 ($i64) $r0 64
    $set $r14 0 999
;
||
    + $r13 ($i64) $r12 0
    + $r12 ($i64) $r0 $r14
;
||
    + $r13 ($i64) $r28 $r13
;
||
    $st ($i64) [$r13 + 0] $r11
;
||
    + $r13 ($i64) $r0 5
;
||
    $cmov ? ($i64) $r13 >= $r12 $r15
    + $r13 ($i64) $r0 72
    $set $r15 0 999
;
||
    + $r14 ($i64) $r13 0
    + $r13 ($i64) $r0 -5
;
||
    + $r14 ($i64) $r28 $r14
;
||
    $st ($i64) [$r14 + 0] $r12
;
||
    + $r14 ($i64) $r0 $r15
    + $r15 ($i64) $r0 80
;
||
    $cmov ? ($i64) $r13 >= $r14 $r16
    + $r16 ($i64) $r15 0
    + $r15 ($i64) $r0 $r17
;
||
    + $r16 ($i64) $r28 $r16
;
||
    $st ($i64) [$r16 + 0] $r14
;
||
    + $r16 ($i64) $r0 0
;
||
    $cmov ? ($i64) $r16 <= $r15 $r18
    + $r16 ($i64) $r0 88
    $set $r18 0 999
;
||
    + $r17 ($i64) $r16 0
    + $r16 ($i64) $r0 -5
;
||
    + $r17 ($i64) $r28 $r17
;
||
    $st ($i64) [$r17 + 0] $r15
;
||
    + $r17 ($i64) $r0 $r18
    + $r18 ($i64) $r0 96
;
||
    $cmov ? ($i64) $r16 <= $r17 $r19
    + $r19 ($i64) $r18 0
    + $r18 ($i64) $r0 $r20
;
||
    + $r19 ($i64) $r28 $r19
;
||
    $st ($i64) [$r19 + 0] $r17
;
||
    + $r19 ($i64) $r0 5
;
||
    $cmov ? ($i64) $r19 <= $r18 $r21
    + $r19 ($i64) $r0 104
;
||
    + $r20 ($i64) $r19 0
;
||
    + $r20 ($i64) $r28 $r20
;
||
    $st ($i64) [$r20 + 0] $r18
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
