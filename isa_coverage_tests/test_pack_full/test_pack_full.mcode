// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 808
    $set $r2 0 48879
    $set $r3 0 57005
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    + $r4 ($i64) $r0 $r2
    + $r5 ($i64) $r0 $r3
    $set $r3 0 22136
;
||
    $pack 32 $r1 16 $r4
    $set $r4 0 4660
    $set $r5 0 39612
;
||
    $st ($i64) [$r28 + 0] $r1
    << $r4 ($i64) $r4 16
    << $r5 ($i64) $r5 16
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 57072
    + $r1 ($i64) $r0 1
;
||
    | $r4 ($i64) $r4 $r5
    + $r6 ($i64) $r0 $r3
    + $r3 ($i64) $r0 8
    $set $r5 0 21845
;
||
    + $r7 ($i64) $r0 $r4
    + $r4 ($i64) $r3 0
    << $r5 ($i64) $r5 16
;
||
    $pack 64 $r2 32 $r6
    + $r4 ($i64) $r28 $r4
    $set $r6 0 4660
    $set $r7 0 43690
;
||
    $st ($i64) [$r4 + 0] $r2
    << $r6 ($i64) $r6 16
    << $r7 ($i64) $r7 16
;
||
    $set $r4 0 22136
;
||
    | $r4 ($i64) $r4 $r6
    $set $r6 0 43690
;
||
    | $r6 ($i64) $r6 $r7
    + $r8 ($i64) $r0 $r4
    + $r4 ($i64) $r0 16
    + $r7 ($i64) $r0 291
;
||
    + $r9 ($i64) $r0 $r6
    + $r6 ($i64) $r4 0
    << $r7 ($i64) $r7 16
;
||
    $pack 32 $r3 32 $r8
    + $r6 ($i64) $r28 $r6
    $set $r8 0 35243
    $set $r9 0 17767
;
||
    $st ($i64) [$r6 + 0] $r3
    | $r9 ($i64) $r9 $r7
    $set $r7 0 21845
;
||
    $set $r6 0 52719
    << $r9 ($i64) $r9 16
    | $r7 ($i64) $r7 $r5
;
||
    | $r8 ($i64) $r8 $r9
    $set $r9 0 21845
    << $r7 ($i64) $r7 16
;
||
    << $r8 ($i64) $r8 16
    | $r9 ($i64) $r9 $r7
;
||
    | $r6 ($i64) $r6 $r8
    $set $r8 0 21845
    << $r9 ($i64) $r9 16
;
||
    | $r8 ($i64) $r8 $r9
    + $r2 ($i64) $r0 $r6
    + $r6 ($i64) $r0 24
;
||
    + $r3 ($i64) $r0 $r8
    + $r8 ($i64) $r6 0
;
||
    $pack 64 $r4 64 $r2
    + $r8 ($i64) $r28 $r8
;
||
    $st ($i64) [$r8 + 0] $r4
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
