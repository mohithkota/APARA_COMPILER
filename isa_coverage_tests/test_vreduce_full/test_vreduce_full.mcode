// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 856
    $set $r2 0 513
    $set $r3 0 1027
    $set $r4 0 1541
    $set $r5 0 2055
    + $r6 ($i64) $r0 4
    + $r8 ($i64) $r0 8
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    + $r9 ($i64) $r8 0
    + $r11 ($i64) $r0 16
    + $r15 ($i64) $r0 32
    $set $r18 0 64515
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    $set $r5 0 3
    + $r9 ($i64) $r28 $r9
    + $r8 ($i64) $r26 -16
    + $r12 ($i64) $r11 0
    + $r16 ($i64) $r15 0
    $set $r19 0 1541
;
||
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    + $r6 ($i64) $r0 2
    + $r12 ($i64) $r28 $r12
    + $r16 ($i64) $r28 $r16
    $set $r20 0 2055
    $set $r21 0 65532
    $set $r22 0 65535
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 2
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    << $r20 ($i64) $r20 16
    << $r21 ($i64) $r21 16
    << $r22 ($i64) $r22 16
    + $r29 ($i64) $r0 64
;
||
    << $r3 ($i64) $r3 16
    | $r4 ($i64) $r4 $r5
    $set $r5 0 0
    | $r19 ($i64) $r19 $r20
    $set $r20 0 3
    + $r30 ($i64) $r29 0
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 1
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    << $r19 ($i64) $r19 16
    | $r20 ($i64) $r20 $r21
    $set $r21 0 65534
    + $r30 ($i64) $r28 $r30
;
||
    $st ($i64) [$r1 + 0] $r2
    | $r3 ($i64) $r3 $r4
    $set $r4 0 1
    << $r5 ($i64) $r5 16
    | $r18 ($i64) $r18 $r19
    $set $r19 0 2
    << $r20 ($i64) $r20 16
    | $r21 ($i64) $r21 $r22
;
||
    + $r2 ($i64) $r26 -16
    | $r4 ($i64) $r4 $r5
    << $r18 ($i64) $r18 16
    | $r19 ($i64) $r19 $r20
    $set $r20 0 0
    << $r21 ($i64) $r21 16
    + $r22 ($i64) $r0 48
;
||
    $st ($i64) [$r2 + 0] $r3
    << $r19 ($i64) $r19 16
    | $r20 ($i64) $r20 $r21
    + $r23 ($i64) $r22 0
;
||
    + $r3 ($i64) $r26 -24
    << $r20 ($i64) $r20 16
    + $r23 ($i64) $r28 $r23
    + $r2 ($i64) $r0 80
;
||
    $st ($i64) [$r3 + 0] $r4
;
||
    + $r4 ($i64) $r26 -8
    + $r3 ($i64) $r2 0
;
||
    $ld ($i64) $r5 [$r4 + 0]
    + $r3 ($i64) $r28 $r3
;
||
    $vreduce + $r6 ($vi8) $r5
    $vreduce + $r7 ($vu8) $r5
;
||
    $st ($i64) [$r28 + 0] $r6
    $st ($i64) [$r9 + 0] $r7
    $ld ($i64) $r9 [$r8 + 0]
;
||
    $vreduce + $r10 ($vi16) $r9
    $vreduce + $r11 ($vu16) $r9
;
||
    $st ($i64) [$r12 + 0] $r10
;
||
    + $r12 ($i64) $r0 24
;
||
    + $r13 ($i64) $r12 0
    + $r12 ($i64) $r26 -24
;
||
    + $r13 ($i64) $r28 $r13
;
||
    $st ($i64) [$r13 + 0] $r11
    $ld ($i64) $r13 [$r12 + 0]
;
||
    $vreduce + $r14 ($vi32) $r13
    $vreduce + $r15 ($vu32) $r13
;
||
    $st ($i64) [$r16 + 0] $r14
;
||
    + $r16 ($i64) $r0 40
;
||
    + $r17 ($i64) $r16 0
    + $r16 ($i64) $r26 -32
;
||
    + $r17 ($i64) $r28 $r17
;
||
    $st ($i64) [$r17 + 0] $r15
;
||
    $set $r17 0 513
;
||
    | $r17 ($i64) $r17 $r18
    $set $r18 0 1
;
||
    $st ($i64) [$r16 + 0] $r17
    | $r18 ($i64) $r18 $r19
    $set $r19 0 1
;
||
    + $r17 ($i64) $r26 -40
    | $r19 ($i64) $r19 $r20
;
||
    $st ($i64) [$r17 + 0] $r18
;
||
    + $r18 ($i64) $r26 -48
;
||
    $st ($i64) [$r18 + 0] $r19
;
||
    + $r19 ($i64) $r26 -32
;
||
    $ld ($i64) $r20 [$r19 + 0]
;
||
    $vreduce + $r21 ($vi8) $r20
    $vreduce + $r22 ($vu8) $r20
;
||
    $st ($i64) [$r23 + 0] $r21
;
||
    + $r23 ($i64) $r0 56
;
||
    + $r24 ($i64) $r23 0
    + $r23 ($i64) $r26 -40
;
||
    + $r24 ($i64) $r28 $r24
;
||
    $st ($i64) [$r24 + 0] $r22
    $ld ($i64) $r24 [$r23 + 0]
;
||
    $vreduce + $r25 ($vi16) $r24
    $vreduce + $r29 ($vu16) $r24
;
||
    $st ($i64) [$r30 + 0] $r25
;
||
    + $r30 ($i64) $r0 72
;
||
    + $r31 ($i64) $r30 0
    + $r30 ($i64) $r26 -48
;
||
    + $r31 ($i64) $r28 $r31
;
||
    $st ($i64) [$r31 + 0] $r29
    $ld ($i64) $r31 [$r30 + 0]
;
||
    $vreduce + $r1 ($vi32) $r31
    $vreduce + $r2 ($vu32) $r31
;
||
    $st ($i64) [$r3 + 0] $r1
;
||
    + $r3 ($i64) $r0 88
    + $r1 ($i64) $r0 1
;
||
    + $r4 ($i64) $r3 0
;
||
    + $r4 ($i64) $r28 $r4
;
||
    $st ($i64) [$r4 + 0] $r2
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
