// ── APARA startup (APARA C Compiler v6: 28-reg + spilling) ──────────────────
// Fixed: $r0=ZERO $r28=GBASE=0x400  Reserved: $r26=FP $r27=SP
// Pool:  $r1-$r25 $r29-$r31  (28 registers, all recycled dynamically)
apara_start:
||
    $set $r28 0 1024
    $set $r27 0 65528
;
||
    + $r26 ($i64) $r0 $r27
    $call main
;
||
    $halt
;
main:
||
    $st ($i64) [$r27 + 0] $r26
    $set $r1 0 856
    $set $r2 0 513
    $set $r3 0 1027
    $set $r4 0 1541
    $set $r5 0 2055
    + $r6 ($i64) $r0 257
    + $r9 ($i64) $r0 8
;
||
    + $r26 ($i64) $r0 $r27
    - $r27 ($i64) $r27 $r1
    << $r5 ($i64) $r5 16
    << $r6 ($i64) $r6 16
    + $r10 ($i64) $r9 0
    $set $r13 0 64515
    $set $r14 0 1541
    $set $r15 0 2055
;
||
    + $r1 ($i64) $r26 -8
    | $r4 ($i64) $r4 $r5
    $set $r5 0 257
    + $r10 ($i64) $r28 $r10
    << $r15 ($i64) $r15 16
    + $r17 ($i64) $r0 32
    $set $r20 0 2
    $set $r21 0 3
;
||
    << $r4 ($i64) $r4 16
    | $r5 ($i64) $r5 $r6
    | $r14 ($i64) $r14 $r15
    + $r18 ($i64) $r17 0
    + $r22 ($i64) $r0 4
    + $r23 ($i64) $r0 1
    + $r25 ($i64) $r0 48
;
||
    | $r3 ($i64) $r3 $r4
    $set $r4 0 257
    << $r5 ($i64) $r5 16
    << $r14 ($i64) $r14 16
    + $r18 ($i64) $r28 $r18
    << $r22 ($i64) $r22 16
    << $r23 ($i64) $r23 16
    + $r29 ($i64) $r25 0
;
||
    << $r3 ($i64) $r3 16
    | $r4 ($i64) $r4 $r5
    + $r5 ($i64) $r26 -16
    | $r13 ($i64) $r13 $r14
    + $r14 ($i64) $r26 -16
    | $r21 ($i64) $r21 $r22
    $set $r22 0 1
    + $r29 ($i64) $r28 $r29
;
||
    | $r2 ($i64) $r2 $r3
    $set $r3 0 257
    << $r4 ($i64) $r4 16
    << $r13 ($i64) $r13 16
    << $r21 ($i64) $r21 16
    | $r22 ($i64) $r22 $r23
;
||
    $st ($i64) [$r1 + 0] $r2
    | $r3 ($i64) $r3 $r4
    | $r20 ($i64) $r20 $r21
    $set $r21 0 1
    << $r22 ($i64) $r22 16
;
||
    + $r2 ($i64) $r26 -16
    << $r20 ($i64) $r20 16
    | $r21 ($i64) $r21 $r22
    + $r22 ($i64) $r26 -40
;
||
    $st ($i64) [$r2 + 0] $r3
    $ld ($i64) $r6 [$r5 + 0]
    << $r21 ($i64) $r21 16
;
||
    + $r3 ($i64) $r26 -8
    $set $r2 0 2
    $set $r5 0 65532
;
||
    $ld ($i64) $r4 [$r3 + 0]
    << $r5 ($i64) $r5 16
;
||
    $dot $r7 ($vi8) $r4 $r6
    $dot $r8 ($vu8) $r4 $r6
    $set $r3 0 3
;
||
    $st ($i64) [$r28 + 0] $r7
    $st ($i64) [$r10 + 0] $r8
    | $r3 ($i64) $r3 $r5
;
||
    + $r10 ($i64) $r0 100
    << $r3 ($i64) $r3 16
    + $r8 ($i64) $r0 80
;
||
    + $r9 ($i64) $r0 $r10
    + $r10 ($i64) $r0 16
    | $r2 ($i64) $r2 $r3
    + $r3 ($i64) $r26 -40
;
||
    $dot $accumulate $r9 ($vi8) $r4 $r6
    + $r11 ($i64) $r10 0
    << $r2 ($i64) $r2 16
;
||
    + $r11 ($i64) $r28 $r11
;
||
    $st ($i64) [$r11 + 0] $r9
;
||
    + $r11 ($i64) $r0 100
    + $r9 ($i64) $r8 0
;
||
    + $r10 ($i64) $r0 $r11
    + $r11 ($i64) $r0 24
    + $r9 ($i64) $r28 $r9
;
||
    $dot $accumulate $r10 ($vu8) $r4 $r6
    + $r12 ($i64) $r11 0
    + $r11 ($i64) $r26 -24
;
||
    + $r12 ($i64) $r28 $r12
;
||
    $st ($i64) [$r12 + 0] $r10
;
||
    $set $r12 0 513
;
||
    | $r12 ($i64) $r12 $r13
;
||
    $st ($i64) [$r11 + 0] $r12
    $ld ($i64) $r15 [$r14 + 0]
;
||
    + $r12 ($i64) $r26 -24
;
||
    $ld ($i64) $r13 [$r12 + 0]
;
||
    $dot $r16 ($vi8) $r13 $r15
    $dot $r17 ($vu8) $r13 $r15
;
||
    $st ($i64) [$r18 + 0] $r16
;
||
    + $r18 ($i64) $r0 40
;
||
    + $r19 ($i64) $r18 0
    + $r18 ($i64) $r26 -32
;
||
    + $r19 ($i64) $r28 $r19
;
||
    $st ($i64) [$r19 + 0] $r17
;
||
    $set $r19 0 1
;
||
    | $r19 ($i64) $r19 $r20
    $set $r20 0 1
;
||
    $st ($i64) [$r18 + 0] $r19
    | $r20 ($i64) $r20 $r21
;
||
    + $r19 ($i64) $r26 -40
;
||
    $st ($i64) [$r19 + 0] $r20
    $ld ($i64) $r23 [$r22 + 0]
;
||
    + $r20 ($i64) $r26 -32
;
||
    $ld ($i64) $r21 [$r20 + 0]
;
||
    $dot $r24 ($vi16) $r21 $r23
    $dot $r25 ($vu16) $r21 $r23
;
||
    $st ($i64) [$r29 + 0] $r24
;
||
    + $r29 ($i64) $r0 56
;
||
    + $r30 ($i64) $r29 0
;
||
    + $r30 ($i64) $r28 $r30
;
||
    $st ($i64) [$r30 + 0] $r25
;
||
    + $r30 ($i64) $r0 50
;
||
    + $r29 ($i64) $r0 $r30
    + $r30 ($i64) $r0 64
;
||
    $dot $accumulate $r29 ($vi16) $r21 $r23
    + $r31 ($i64) $r30 0
;
||
    + $r31 ($i64) $r28 $r31
;
||
    $st ($i64) [$r31 + 0] $r29
;
||
    + $r31 ($i64) $r0 50
;
||
    + $r30 ($i64) $r0 $r31
    + $r31 ($i64) $r0 72
;
||
    $dot $accumulate $r30 ($vu16) $r21 $r23
    + $r1 ($i64) $r31 0
    + $r31 ($i64) $r26 -48
;
||
    + $r1 ($i64) $r28 $r1
;
||
    $st ($i64) [$r1 + 0] $r30
;
||
    $set $r1 0 1
;
||
    | $r1 ($i64) $r1 $r2
;
||
    $st ($i64) [$r31 + 0] $r1
    $ld ($i64) $r5 [$r3 + 0]
;
||
    + $r1 ($i64) $r26 -48
;
||
    $ld ($i64) $r2 [$r1 + 0]
;
||
    $dot $r7 ($vi16) $r2 $r5
    $dot $r8 ($vu16) $r2 $r5
    + $r1 ($i64) $r0 1
;
||
    $st ($i64) [$r9 + 0] $r7
;
||
    + $r9 ($i64) $r0 88
;
||
    + $r4 ($i64) $r9 0
;
||
    + $r4 ($i64) $r28 $r4
;
||
    $st ($i64) [$r4 + 0] $r8
    ? ($i64) $r0 == $goto main_epilogue
;
main_epilogue:
||
    + $r27 ($i64) $r0 $r26
;
||
    $ld ($i64) $r26 [$r27 + 0]
    $return
;
